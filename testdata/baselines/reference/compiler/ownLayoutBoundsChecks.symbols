    wait(): void;
>wait : Symbol(BarrierCell.wait, Decl(own.d.mts, 21, 30))
}
export declare const Barrier: new (threads: number) => shared BarrierCell;
>Barrier : Symbol(Barrier, Decl(own.d.mts, 25, 20))
>threads : Symbol(threads, Decl(own.d.mts, 25, 35))
>BarrierCell : Symbol(BarrierCell, Decl(own.d.mts, 18, 74))

/** Freezes a value the caller owns into a deeply immutable value every thread can read. */
export declare function share<T>(value: sending T): shared T;
>share : Symbol(share, Decl(own.d.mts, 25, 74))
>T : Symbol(T, Decl(own.d.mts, 28, 30))
>value : Symbol(value, Decl(own.d.mts, 28, 33))
>T : Symbol(T, Decl(own.d.mts, 28, 30))
>T : Symbol(T, Decl(own.d.mts, 28, 30))

/** A thread started inside a `scope`; joining it moves the thread's result back. */
