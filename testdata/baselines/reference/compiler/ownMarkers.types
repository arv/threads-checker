export function makeList(n: number): Node | null {
>makeList : (n: number) => Node | null
>n : number

    let head: Node | null = null;
>head : Node | null

    for (let i = 0; i < n; i++) {
>i : number
>0 : 0
>i < n : boolean
>i : number
>n : number
>i++ : number
>i : number

        const node = new Node();
>node : Node & import("./threads.mjs").Cell
>new Node() : Node & import("./threads.mjs").Cell
>Node : import("./threads.mjs").StructType<Node>

        node.value = i;
>node.value = i : number
>node.value : number
>node : Node & import("./threads.mjs").Cell
>value : number
>i : number

        node.next = head;
>node.next = head : Node | null
>node.next : Node | null
>node : Node & import("./threads.mjs").Cell
>next : Node | null
>head : Node | null

        head = node;
>head = node : Node & import("./threads.mjs").Cell
>head : Node | null
>node : Node & import("./threads.mjs").Cell
    }
    return head;
>head : Node | null
}

