// Channels of counted values.
function produce(out: Channel<SharedArray<number>>) {
>produce : (out: Channel<SharedArray<number>>) => void
>out : Channel<SharedArray<number>>

    for (let k = 0; k < 4; k++) out.send(new SharedArray(Number, 16));
>k : number
>0 : 0
>k < 4 : boolean
>k : number
>4 : 4
>k++ : number
>k : number
>out.send(new SharedArray(Number, 16)) : void
>out.send : (value: SharedArray<number>) => void
>out : Channel<SharedArray<number>>
>send : (value: SharedArray<number>) => void
>new SharedArray(Number, 16) : SharedArray<number>
>SharedArray : { new (type: NumberConstructor, length: number): SharedArray<number>; new <T>(type: import("./threads.mjs").StructType<T>, length: number): SharedArray<T & import("./threads.mjs").Cell>; }
>Number : NumberConstructor
>16 : 16

    out.close();
>out.close() : void
>out.close : () => void
>out : Channel<SharedArray<number>>
>close : () => void
}
export function consumeAll() {
>consumeAll : () => number

    const ch = new Channel<SharedArray<number>>(2);
>ch : Channel<SharedArray<number>>
>new Channel<SharedArray<number>>(2) : Channel<SharedArray<number>>
>Channel : typeof Channel
>2 : 2

    go(produce, ch);
>go(produce, ch) : void
>go : <A extends unknown[]>(f: (...args: A) => void, ...args: Sending<A>) => void
>produce : (out: Channel<SharedArray<number>>) => void
>ch : Channel<SharedArray<number>>

    let sum = 0;
>sum : number
>0 : 0

    for (const block of ch) sum += block.length;
>block : SharedArray<number>
>ch : Channel<SharedArray<number>>
>sum += block.length : number
>sum : number
>block.length : number
>block : SharedArray<number>
>length : number

    return sum;
>sum : number
}

