// The n-body gather: each step builds `slots` from received messages, then shares it.
export function gather(steps: number, threads: number) {
>gather : Symbol(gather, Decl(ownSharedLoopBindings.ts, 9, 54))
>steps : Symbol(steps, Decl(ownSharedLoopBindings.ts, 12, 23))
>threads : Symbol(threads, Decl(ownSharedLoopBindings.ts, 12, 37))

    for (let s = 0; s < steps; s++) {
>s : Symbol(s, Decl(ownSharedLoopBindings.ts, 13, 12))
>s : Symbol(s, Decl(ownSharedLoopBindings.ts, 13, 12))
>steps : Symbol(steps, Decl(ownSharedLoopBindings.ts, 12, 23))
>s : Symbol(s, Decl(ownSharedLoopBindings.ts, 13, 12))

        const slots: Pos[][] = [];
>slots : Symbol(slots, Decl(ownSharedLoopBindings.ts, 14, 13))
>Pos : Symbol(Pos, Decl(ownSharedLoopBindings.ts, 0, 0))

        for (let k = 0; k < threads; k++) {
>k : Symbol(k, Decl(ownSharedLoopBindings.ts, 15, 16))
>k : Symbol(k, Decl(ownSharedLoopBindings.ts, 15, 16))
>threads : Symbol(threads, Decl(ownSharedLoopBindings.ts, 12, 37))
>k : Symbol(k, Decl(ownSharedLoopBindings.ts, 15, 16))

            const m = recv()!;
>m : Symbol(m, Decl(ownSharedLoopBindings.ts, 16, 17))
>recv : Symbol(recv, Decl(ownSharedLoopBindings.ts, 7, 45))

            slots[m.t] = m.pos;
>slots : Symbol(slots, Decl(ownSharedLoopBindings.ts, 14, 13))
>m.t : Symbol(t, Decl(ownSharedLoopBindings.ts, 5, 18))
>m : Symbol(m, Decl(ownSharedLoopBindings.ts, 16, 17))
>t : Symbol(t, Decl(ownSharedLoopBindings.ts, 5, 18))
>m.pos : Symbol(pos, Decl(ownSharedLoopBindings.ts, 5, 29))
>m : Symbol(m, Decl(ownSharedLoopBindings.ts, 16, 17))
>pos : Symbol(pos, Decl(ownSharedLoopBindings.ts, 5, 29))
        }
        const all = share(slots.flat());
>all : Symbol(all, Decl(ownSharedLoopBindings.ts, 19, 13))
>share : Symbol(share, Decl(ownSharedLoopBindings.ts, 5, 43))
>slots.flat : Symbol(Array.flat, Decl(lib.es2019.array.d.ts, --, --))
>slots : Symbol(slots, Decl(ownSharedLoopBindings.ts, 14, 13))
>flat : Symbol(Array.flat, Decl(lib.es2019.array.d.ts, --, --))

        use(all);
>use : Symbol(use, Decl(ownSharedLoopBindings.ts, 8, 55))
>all : Symbol(all, Decl(ownSharedLoopBindings.ts, 19, 13))
    }
}

