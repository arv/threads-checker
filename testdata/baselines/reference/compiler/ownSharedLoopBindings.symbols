>t : Symbol(t, Decl(ownSharedLoopBindings.ts, 5, 18))
>pos : Symbol(pos, Decl(ownSharedLoopBindings.ts, 5, 29))
>Pos : Symbol(Pos, Decl(ownSharedLoopBindings.ts, 0, 0))

declare function share<T>(x: sending T): shared T;
>share : Symbol(share, Decl(ownSharedLoopBindings.ts, 5, 43))
>T : Symbol(T, Decl(ownSharedLoopBindings.ts, 6, 23))
>x : Symbol(x, Decl(ownSharedLoopBindings.ts, 6, 26))
>T : Symbol(T, Decl(ownSharedLoopBindings.ts, 6, 23))
>T : Symbol(T, Decl(ownSharedLoopBindings.ts, 6, 23))

declare function send<T>(x: sending T): void;
>send : Symbol(send, Decl(ownSharedLoopBindings.ts, 6, 50))
