// The n-body gather: each step builds `slots` from received messages, then shares it.
export function gather(steps: number, threads: number) {
>gather : Symbol(gather, Decl(loops.mts, 6, 46))
>steps : Symbol(steps, Decl(loops.mts, 9, 23))
>threads : Symbol(threads, Decl(loops.mts, 9, 37))

    for (let s = 0; s < steps; s++) {
>s : Symbol(s, Decl(loops.mts, 10, 12))
>s : Symbol(s, Decl(loops.mts, 10, 12))
>steps : Symbol(steps, Decl(loops.mts, 9, 23))
>s : Symbol(s, Decl(loops.mts, 10, 12))

        const slots: Pos[][] = [];
>slots : Symbol(slots, Decl(loops.mts, 11, 13))
>Pos : Symbol(Pos, Decl(loops.mts, 0, 65))

        for (let k = 0; k < threads; k++) {
>k : Symbol(k, Decl(loops.mts, 12, 16))
>k : Symbol(k, Decl(loops.mts, 12, 16))
>threads : Symbol(threads, Decl(loops.mts, 9, 37))
>k : Symbol(k, Decl(loops.mts, 12, 16))

            const m = recv()!;
>m : Symbol(m, Decl(loops.mts, 13, 17))
>recv : Symbol(recv, Decl(loops.mts, 4, 46))

            slots[m.t] = m.pos;
>slots : Symbol(slots, Decl(loops.mts, 11, 13))
>m.t : Symbol(t, Decl(loops.mts, 3, 18))
>m : Symbol(m, Decl(loops.mts, 13, 17))
>t : Symbol(t, Decl(loops.mts, 3, 18))
>m.pos : Symbol(pos, Decl(loops.mts, 3, 29))
>m : Symbol(m, Decl(loops.mts, 13, 17))
>pos : Symbol(pos, Decl(loops.mts, 3, 29))
        }
        const all = share(slots.flat());
>all : Symbol(all, Decl(loops.mts, 16, 13))
>share : Symbol(share, Decl(loops.mts, 0, 35))
>slots.flat : Symbol(Array.flat, Decl(lib.es2019.array.d.ts, --, --))
>slots : Symbol(slots, Decl(loops.mts, 11, 13))
>flat : Symbol(Array.flat, Decl(lib.es2019.array.d.ts, --, --))

        use(all);
>use : Symbol(use, Decl(loops.mts, 5, 56))
>all : Symbol(all, Decl(loops.mts, 16, 13))
    }
}

export function nested(steps: number) {
>nested : Symbol(nested, Decl(loops.mts, 19, 1))
>steps : Symbol(steps, Decl(loops.mts, 21, 23))

    for (let s = 0; s < steps; s++) {
>s : Symbol(s, Decl(loops.mts, 22, 12))
>s : Symbol(s, Decl(loops.mts, 22, 12))
>steps : Symbol(steps, Decl(loops.mts, 21, 23))
>s : Symbol(s, Decl(loops.mts, 22, 12))

        do {
            const { pos } = recv()!;          // destructured: fresh bindings too
>pos : Symbol(pos, Decl(loops.mts, 24, 19))
>recv : Symbol(recv, Decl(loops.mts, 4, 46))

            send(pos);
>send : Symbol(send, Decl(loops.mts, 3, 43))
>pos : Symbol(pos, Decl(loops.mts, 24, 19))

        } while (steps > s);
>steps : Symbol(steps, Decl(loops.mts, 21, 23))
>s : Symbol(s, Decl(loops.mts, 22, 12))

        let last: Pos[] = [];
>last : Symbol(last, Decl(loops.mts, 27, 11))
>Pos : Symbol(Pos, Decl(loops.mts, 0, 65))

        while (last.length < 3) {
>last.length : Symbol(Array.length, Decl(lib.es5.d.ts, --, --))
>last : Symbol(last, Decl(loops.mts, 27, 11))
>length : Symbol(Array.length, Decl(lib.es5.d.ts, --, --))

            const next = recv()!.pos;
>next : Symbol(next, Decl(loops.mts, 29, 17))
>recv()!.pos : Symbol(pos, Decl(loops.mts, 3, 29))
>recv : Symbol(recv, Decl(loops.mts, 4, 46))
>pos : Symbol(pos, Decl(loops.mts, 3, 29))

            last.push(...next);
>last.push : Symbol(Array.push, Decl(lib.es5.d.ts, --, --))
>last : Symbol(last, Decl(loops.mts, 27, 11))
>push : Symbol(Array.push, Decl(lib.es5.d.ts, --, --))
>next : Symbol(next, Decl(loops.mts, 29, 17))
        }
        send(last);
>send : Symbol(send, Decl(loops.mts, 3, 43))
>last : Symbol(last, Decl(loops.mts, 27, 11))
    }
}

export function outside(steps: number) {
>outside : Symbol(outside, Decl(loops.mts, 34, 1))
>steps : Symbol(steps, Decl(loops.mts, 36, 24))

    const slots: Pos[][] = [];
>slots : Symbol(slots, Decl(loops.mts, 37, 9))
>Pos : Symbol(Pos, Decl(loops.mts, 0, 65))

    for (let s = 0; s < steps; s++) {
>s : Symbol(s, Decl(loops.mts, 38, 12))
>s : Symbol(s, Decl(loops.mts, 38, 12))
>steps : Symbol(steps, Decl(loops.mts, 36, 24))
>s : Symbol(s, Decl(loops.mts, 38, 12))

        const all = share(slots.flat());      // error: sent in an earlier iteration
>all : Symbol(all, Decl(loops.mts, 39, 13))
>share : Symbol(share, Decl(loops.mts, 0, 35))
>slots.flat : Symbol(Array.flat, Decl(lib.es2019.array.d.ts, --, --))
>slots : Symbol(slots, Decl(loops.mts, 37, 9))
>flat : Symbol(Array.flat, Decl(lib.es2019.array.d.ts, --, --))

        use(all);
>use : Symbol(use, Decl(loops.mts, 5, 56))
>all : Symbol(all, Decl(loops.mts, 39, 13))
    }
}

