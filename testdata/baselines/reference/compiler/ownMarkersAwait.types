import type { Sending } from "./threads.mjs";
>Sending : T

export declare function run<A extends unknown[], R>(f: (...args: A) => Sending<R>, ...args: Sending<A>): Promise<Sending<R>>;
>run : <A extends unknown[], R>(f: (...args: A) => Sending<R>, ...args: Sending<A>) => Promise<Sending<R>>
>f : (...args: A) => Sending<R>
>args : A
>args : A

=== await.mts ===
import { SharedArray, spawn, type Thread } from "./threads.mjs";
>SharedArray : { new (type: NumberConstructor, length: number): SharedArray<number>; new <T>(type: import("./threads.mjs").StructType<T>, length: number): SharedArray<T & import("./threads.mjs").Cell>; }
>spawn : <A extends unknown[], R>(f: (...args: A) => import("./threads.mjs").Sending<R>, ...args: import("./threads.mjs").Sending<A>) => Thread<R>
>Thread : any

import { run } from "./browser.mjs";
>run : <A extends unknown[], R>(f: (...args: A) => import("./threads.mjs").Sending<R>, ...args: import("./threads.mjs").Sending<A>) => Promise<import("./threads.mjs").Sending<R>>

function fill(n: number): SharedArray<number> {
>fill : (n: number) => SharedArray<number>
>n : number

    const a = new SharedArray(Number, n);
>a : SharedArray<number>
>new SharedArray(Number, n) : SharedArray<number>
>SharedArray : { new (type: NumberConstructor, length: number): SharedArray<number>; new <T>(type: import("./threads.mjs").StructType<T>, length: number): SharedArray<T & import("./threads.mjs").Cell>; }
>Number : NumberConstructor
>n : number

    for (let i = 0; i < a.length; i++) a[i] = i;
>i : number
>0 : 0
>i < a.length : boolean
>i : number
>a.length : number
>a : SharedArray<number>
>length : number
>i++ : number
>i : number
>a[i] = i : number
>a[i] : number
>a : SharedArray<number>
>i : number
>i : number

    return a;
>a : SharedArray<number>
}

async function local(n: number): Promise<SharedArray<number>> {
>local : (n: number) => Promise<SharedArray<number>>
>n : number

    return fill(n);
>fill(n) : SharedArray<number>
>fill : (n: number) => SharedArray<number>
>n : number
}

declare function borrowed(): Promise<SharedArray<number>>;   // not Sending: a borrow
>borrowed : () => Promise<SharedArray<number>>

export async function results(thread: Thread<SharedArray<number>>) {
>results : (thread: Thread<SharedArray<number>>) => Promise<number>
>thread : Thread<SharedArray<number>>

    const a = await thread.joinAsync();       // owned: released when the block ends
>a : SharedArray<number>
>await thread.joinAsync() : SharedArray<number>
>thread.joinAsync() : Promise<SharedArray<number>>
>thread.joinAsync : () => Promise<SharedArray<number>>
>thread : Thread<SharedArray<number>>
>joinAsync : () => Promise<SharedArray<number>>

    const b = await run(fill, 4);             // owned
>b : SharedArray<number>
>await run(fill, 4) : SharedArray<number>
>run(fill, 4) : Promise<SharedArray<number>>
>run : <A extends unknown[], R>(f: (...args: A) => import("./threads.mjs").Sending<R>, ...args: import("./threads.mjs").Sending<A>) => Promise<import("./threads.mjs").Sending<R>>
>fill : (n: number) => SharedArray<number>
>4 : 4

    const c = await local(4);                 // owned
>c : SharedArray<number>
>await local(4) : SharedArray<number>
>local(4) : Promise<SharedArray<number>>
>local : (n: number) => Promise<SharedArray<number>>
>4 : 4

    const d = await borrowed();               // retained
>d : SharedArray<number>
>await borrowed() : SharedArray<number>
>borrowed() : Promise<SharedArray<number>>
>borrowed : () => Promise<SharedArray<number>>

    (await run(fill, 8)).length;              // an owned temporary, released
>(await run(fill, 8)).length : number
>(await run(fill, 8)) : SharedArray<number>
>await run(fill, 8) : SharedArray<number>
>run(fill, 8) : Promise<SharedArray<number>>
>run : <A extends unknown[], R>(f: (...args: A) => import("./threads.mjs").Sending<R>, ...args: import("./threads.mjs").Sending<A>) => Promise<import("./threads.mjs").Sending<R>>
>fill : (n: number) => SharedArray<number>
>8 : 8
>length : number

    return a.length + b.length + c.length + d.length + (await run(fill, 2))[0];
>a.length + b.length + c.length + d.length + (await run(fill, 2))[0] : number
>a.length + b.length + c.length + d.length : number
>a.length + b.length + c.length : number
