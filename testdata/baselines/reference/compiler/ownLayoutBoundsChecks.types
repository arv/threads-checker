export function reassigned(a: SharedArray<number>, b: SharedArray<number>) {
>reassigned : (a: SharedArray<number>, b: SharedArray<number>) => number
>a : SharedArray<number>
>b : SharedArray<number>

    let c = a;
>c : SharedArray<number>
>a : SharedArray<number>

    let sum = 0;
>sum : number
>0 : 0

    for (let i = 0; i < c.length; i++) sum += c[i];                      // c is reassigned below
>i : number
>0 : 0
>i < c.length : boolean
>i : number
>c.length : number
>c : SharedArray<number>
>length : number
>i++ : number
>i : number
>sum += c[i] : number
>sum : number
>c[i] : number
>c : SharedArray<number>
>i : number

    c = b;
>c = b : SharedArray<number>
>c : SharedArray<number>
>b : SharedArray<number>

    for (let i = 0; i < a.length; i++) a[i] = sum;                       // a itself is never assigned: eliminated
>i : number
>0 : 0
>i < a.length : boolean
>i : number
>a.length : number
>a : SharedArray<number>
>length : number
>i++ : number
>i : number
>a[i] = sum : number
>a[i] : number
>a : SharedArray<number>
>i : number
>sum : number

    return sum;
>sum : number
}

