export function viaNew() {
>viaNew : Symbol(viaNew, Decl(same.mts, 9, 45))

    const m = new Either();                 // one of two structs with one layout
>m : Symbol(m, Decl(same.mts, 11, 9))
>Either : Symbol(Either, Decl(same.mts, 9, 5))

    m.u = 7;                                // slot 1 of either
>m.u : Symbol(u, Decl(same.mts, 2, 18), Decl(same.mts, 9, 30))
>m : Symbol(m, Decl(same.mts, 11, 9))
>u : Symbol(u, Decl(same.mts, 2, 18), Decl(same.mts, 9, 30))

