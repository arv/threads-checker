  spawn<A extends unknown[], R>(f: (...args: A) => Promise<Sending<R>>, ...args: Sending<A>): Thread<R>;
>spawn : { <A extends unknown[], R>(f: (...args: A) => Promise<Sending<R>>, ...args: Sending<A>): Thread<R>; <A_1 extends unknown[], R_1>(f: (...args: A_1) => Sending<R_1>, ...args: Sending<A_1>): Thread<R_1>; }
>f : (...args: A) => Promise<Sending<R>>
>args : A
>args : A

  spawn<A extends unknown[], R>(f: (...args: A) => Sending<R>, ...args: Sending<A>): Thread<R>;
>spawn : { <A_1 extends unknown[], R_1>(f: (...args: A_1) => Promise<Sending<R_1>>, ...args: Sending<A_1>): Thread<R_1>; <A extends unknown[], R>(f: (...args: A) => Sending<R>, ...args: Sending<A>): Thread<R>; }
>f : (...args: A) => Sending<R>
>args : A
>args : A
}
/** Runs `body` and joins every thread it spawned before returning. */
