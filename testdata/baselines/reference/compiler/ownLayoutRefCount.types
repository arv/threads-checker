>n : number
>i++ : number
>i : number

        const node = new Node();
>node : Node
>new Node() : Node
>Node : new () => Node

        node.value = i;
>node.value = i : number
>node.value : number
>node : Node
>value : number
>i : number

        node.next = head;                    // a borrow stored in a reference field: retained
>node.next = head : Node | null
>node.next : Node | null
>node : Node
>next : Node | null
>head : Node | null

        head = node;                         // the new value is retained before the old is released
>head = node : Node
>head : Node | null
>node : Node
    }
    return head;
>head : Node | null
}

// Traversal: `n` is reassigned, so it is owned (its declaration moves out of the loop); the loop
// reads a reference field, so each iteration ends at a quiescent point.
