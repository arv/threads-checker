>sum : (head: Node | null) => number
>head : Node | null

    let s = 0;
>s : number
>0 : 0

    for (let n = head; n !== null; n = n.next) s += n.value;
>n : Node | null
>head : Node | null
>n !== null : boolean
>n : Node | null
>n = n.next : Node | null
>n : Node | null
>n.next : Node | null
>n : Node
>next : Node | null
>s += n.value : number
>s : number
>n.value : number
>n : Node
>value : number

    return s;
>s : number
}

