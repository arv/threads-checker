// The linked list: building it (`head` is reassigned, so it is owned, and `node` is new), and
// returning it (the owned local's count moves out).
export function makeList(n: number): Node | null {
>makeList : (n: number) => Node | null
>n : number

    let head: Node | null = null;
>head : Node | null

    for (let i = 0; i < n; i++) {
>i : number
>0 : 0
>i < n : boolean
>i : number
>n : number
>i++ : number
>i : number

        const node = new Node();
>node : Node & import("./threads.mjs").Cell
>new Node() : Node & import("./threads.mjs").Cell
>Node : import("./threads.mjs").StructType<Node>

        node.value = i;
>node.value = i : number
>node.value : number
>node : Node & import("./threads.mjs").Cell
>value : number
>i : number

        node.next = head;                    // a borrow stored in a reference field: retained
>node.next = head : Node | null
>node.next : Node | null
>node : Node & import("./threads.mjs").Cell
>next : Node | null
>head : Node | null

        head = node;                         // the new value is retained before the old is released
>head = node : Node & import("./threads.mjs").Cell
>head : Node | null
>node : Node & import("./threads.mjs").Cell
    }
    return head;
>head : Node | null
}

// Traversal: `n` is reassigned, so it is owned (its declaration moves out of the loop); the loop
// reads a reference field, so each iteration ends at a quiescent point.
export function sum(head: Node | null): number {
>sum : (head: Node | null) => number
>head : Node | null

    let s = 0;
>s : number
>0 : 0

    for (let n = head; n !== null; n = n.next) s += n.value;
>n : Node | null
>head : Node | null
>n !== null : boolean
>n : Node | null
>n = n.next : Node | null
>n : Node | null
>n.next : Node | null
>n : Node
>next : Node | null
>s += n.value : number
>s : number
>n.value : number
>n : Node
>value : number

    return s;
>s : number
}

