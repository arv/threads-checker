>x : Box
>({ v: x.v }) : { v: number; }
>{ v: x.v } : { v: number; }
>v : number
>x.v : number
>x : Box
>v : number

    send(fresh);                              // fine: the callback builds fresh objects
>send(fresh) : void
>send : <T>(x: sending T) => void
>fresh : { v: number; }[]

    const nums = xs.map(x => x.v);
>nums : number[]
>xs.map(x => x.v) : number[]
