>x : Box

    send(aliased);                            // error: holds the caller's objects
>send(aliased) : void
>send : <T>(x: sending T) => void
>aliased : Box[]

    const filtered = xs.filter(x => x.v > 0);
>filtered : Box[]
>xs.filter(x => x.v > 0) : Box[]
>xs.filter : { <S extends Box>(predicate: (value: Box, index: number, array: Box[]) => value is S, thisArg?: any): S[]; (predicate: (value: Box, index: number, array: Box[]) => unknown, thisArg?: any): Box[]; }
>xs : Box[]
>filter : { <S extends Box>(predicate: (value: Box, index: number, array: Box[]) => value is S, thisArg?: any): S[]; (predicate: (value: Box, index: number, array: Box[]) => unknown, thisArg?: any): Box[]; }
>x => x.v > 0 : (x: Box) => boolean
>x : Box
>x.v > 0 : boolean
>x.v : number
>x : Box
>v : number
>0 : 0

    send(filtered);                           // error: filter aliases the receiver
