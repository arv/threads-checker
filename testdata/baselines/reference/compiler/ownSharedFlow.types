>x.v : number
>x : Box
>v : number

    send(nums);                               // fine
>send(nums) : void
>send : <T>(x: sending T) => void
>nums : number[]

    const aliased = xs.map(x => x);
>aliased : Box[]
>xs.map(x => x) : Box[]
>xs.map : <U>(callbackfn: (value: Box, index: number, array: Box[]) => U, thisArg?: any) => U[]
>xs : Box[]
>map : <U>(callbackfn: (value: Box, index: number, array: Box[]) => U, thisArg?: any) => U[]
>x => x : (x: Box) => Box
