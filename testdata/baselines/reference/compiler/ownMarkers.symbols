  : T extends object ? { readonly [K in keyof T]: Shared<T[K]> }
>T : Symbol(T, Decl(threads.d.mts, 32, 19))
>K : Symbol(K, Decl(threads.d.mts, 33, 35))
>T : Symbol(T, Decl(threads.d.mts, 32, 19))
