>log : (...args: unknown[]) => void
>SharedArray : { new (type: NumberConstructor, length: number): SharedArray<number>; new <T>(type: import("./own.mjs").SharedStructType<T>, length: number): SharedArray<T>; }

export shared struct Vec { x: number; y: number }
>Vec : Vec
>x : number
>y : number

declare function takeVec(v: Vec): void;
>takeVec : (v: Vec) => void
>v : Vec

declare function takeUnknown(u: unknown): void;
>takeUnknown : (u: unknown) => void
>u : unknown

declare function identity<T>(x: T): T;
>identity : <T>(x: T) => T
>x : T

declare const anything: any;
>anything : any

export function roundTrip(v: Vec) {
>roundTrip : (v: Vec) => number
>v : Vec

    const u: unknown = v;                    // box
>u : unknown
>v : Vec

    const v2 = u as Vec;                     // unbox
>v2 : Vec
>u as Vec : Vec
>u : unknown

    return v2.x;
>v2.x : number
>v2 : Vec
>x : number
}

export function boxed(v: Vec, other: unknown, a: SharedArray<number>) {
>boxed : (v: Vec, other: unknown, a: SharedArray<number>) => (string | number | boolean | object)[]
>v : Vec
>other : unknown
>a : SharedArray<number>

    log(v, a);                               // host function arguments
>log(v, a) : void
