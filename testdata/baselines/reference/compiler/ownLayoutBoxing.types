export function unboxed(u: unknown, a: any) {
>unboxed : (u: unknown, a: any) => number
>u : unknown
>a : any

    takeVec(anything);                       // any into a struct parameter
>takeVec(anything) : void
>takeVec : (v: Vec) => void
>anything : any

    const v = u as Vec;
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>u as Vec : { x: number; y: number; } & import("./threads.mjs").Cell
>u : unknown

    const w: Vec = a;
>w : { x: number; y: number; } & import("./threads.mjs").Cell
>a : any

    if (isVec(u)) {
>isVec(u) : boolean
>isVec : (u: unknown) => u is Vec
>u : unknown

        u.x = 1;                             // narrowed: unboxed where the layout is used
>u.x = 1 : 1
>u.x : number
>u : { x: number; y: number; } & import("./threads.mjs").Cell
>x : number
>1 : 1

        takeVec(u);
>takeVec(u) : void
>takeVec : (v: Vec) => void
>u : { x: number; y: number; } & import("./threads.mjs").Cell
    }
    return v.y + w.y;
>v.y + w.y : number
>v.y : number
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>y : number
>w.y : number
>w : { x: number; y: number; } & import("./threads.mjs").Cell
>y : number
}

function isVec(u: unknown): u is Vec {
>isVec : (u: unknown) => u is Vec
>u : unknown

    return u !== null && typeof u === "object" && "x" in u;
>u !== null && typeof u === "object" && "x" in u : boolean
>u !== null && typeof u === "object" : boolean
>u !== null : boolean
>u : unknown
>typeof u === "object" : boolean
>typeof u : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>u : {} | undefined
>"object" : "object"
>"x" in u : boolean
>"x" : "x"
>u : object
}

export function returns(v: Vec): unknown {
>returns : (v: Vec) => unknown
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    return v;                                // box
>v : { x: number; y: number; } & import("./threads.mjs").Cell
}

export function returnsVec(u: unknown): Vec {
>returnsVec : (u: unknown) => Vec
>u : unknown

    return u as Vec;                         // unbox (the assertion)
>u as Vec : { x: number; y: number; } & import("./threads.mjs").Cell
