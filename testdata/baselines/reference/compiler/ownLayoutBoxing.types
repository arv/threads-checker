}

=== assertion.ts ===
import type { Vec } from "./boxing.mjs";
>Vec : { x: number; y: number; } & import("./threads.mjs").Cell

export function angleBracket(u: unknown) {
>angleBracket : (u: unknown) => number
>u : unknown

    return (<Vec>u).x;                       // unbox (angle-bracket assertion)
>(<Vec>u).x : number
>(<Vec>u) : { x: number; y: number; } & import("./threads.mjs").Cell
><Vec>u : { x: number; y: number; } & import("./threads.mjs").Cell
>u : unknown
>x : number
}

