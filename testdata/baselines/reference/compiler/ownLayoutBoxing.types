>v : Vec
>a : SharedArray<number>

    takeUnknown(v);
>takeUnknown(v) : void
>takeUnknown : (u: unknown) => void
>v : Vec

    const text = `${v} and ` + v;            // strings
>text : string
>`${v} and ` + v : string
>`${v} and ` : string
>v : Vec
>v : Vec

    const kind = typeof v;
>kind : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>typeof v : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>v : Vec

    const same = v === other;                // equality with a non-struct value
>same : boolean
>v === other : boolean
>v : Vec
>other : unknown

    const isNull = v === null;               // stays raw
>isNull : boolean
>v === null : boolean
>v : Vec

    const union: Vec | number = v;
>union : number | Vec
>v : Vec

    const object: object = v;
>object : object
>v : Vec

    const list: unknown[] = [v, a];
>list : unknown[]
>[v, a] : (SharedArray<number> | Vec)[]
>v : Vec
>a : SharedArray<number>

    const record: { v: unknown } = { v };
>record : { v: unknown; }
>v : unknown
>{ v } : { v: Vec; }
>v : Vec

    const copy = { ...v };
>copy : { x: number; y: number; }
>{ ...v } : { x: number; y: number; }
>v : Vec

    const s = v.toString();                  // not a field
>s : string
>v.toString() : string
>v.toString : () => string
>v : Vec
>toString : () => string

    const { x } = v;                         // destructured through the handle
>x : number
>v : Vec

    const has = "x" in v;
>has : boolean
>"x" in v : boolean
>"x" : "x"
>v : Vec

    const same2 = identity(v);               // generic: decided by the instantiation, stays raw
>same2 : Vec
>identity(v) : Vec
>identity : <T>(x: T) => T
>v : Vec

    return [text, kind, same, isNull, union, object, list, record, copy, s, x, has, same2.y];
>[text, kind, same, isNull, union, object, list, record, copy, s, x, has, same2.y] : (string | number | boolean | object)[]
>text : string
>kind : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>same : boolean
>isNull : boolean
>union : Vec
>object : object
>list : unknown[]
>record : { v: unknown; }
>copy : { x: number; y: number; }
>s : string
>x : number
>has : boolean
>same2.y : number
>same2 : Vec
>y : number
}

export function unboxed(u: unknown, a: any) {
>unboxed : (u: unknown, a: any) => number
>u : unknown
>a : any

    takeVec(anything);                       // any into a struct parameter
>takeVec(anything) : void
>takeVec : (v: Vec) => void
>anything : any

    const v = u as Vec;
>v : Vec
>u as Vec : Vec
>u : unknown

    const w: Vec = a;
>w : Vec
>a : any

    if (isVec(u)) {
>isVec(u) : boolean
>isVec : (u: unknown) => u is Vec
>u : unknown

        u.x = 1;                             // narrowed: unboxed where the layout is used
>u.x = 1 : 1
>u.x : number
>u : Vec
>x : number
>1 : 1

        takeVec(u);
>takeVec(u) : void
>takeVec : (v: Vec) => void
>u : Vec
    }
    return v.y + w.y;
>v.y + w.y : number
>v.y : number
>v : Vec
>y : number
>w.y : number
>w : Vec
>y : number
}

function isVec(u: unknown): u is Vec {
>isVec : (u: unknown) => u is Vec
>u : unknown

    return u !== null && typeof u === "object" && "x" in u;
>u !== null && typeof u === "object" && "x" in u : boolean
>u !== null && typeof u === "object" : boolean
>u !== null : boolean
>u : unknown
>typeof u === "object" : boolean
>typeof u : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>u : {} | undefined
>"object" : "object"
>"x" in u : boolean
>"x" : "x"
>u : object
}

export function returns(v: Vec): unknown {
>returns : (v: Vec) => unknown
>v : Vec

    return v;                                // box
>v : Vec
}

export function returnsVec(u: unknown): Vec {
>returnsVec : (u: unknown) => Vec
>u : unknown

    return u as Vec;                         // unbox (the assertion)
>u as Vec : Vec
>u : unknown
}

