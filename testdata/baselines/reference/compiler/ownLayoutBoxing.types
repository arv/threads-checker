>v.toString() : string
>v.toString : () => string
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>toString : () => string

    const { x } = v;                         // destructured through the handle
>x : number
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const has = "x" in v;
>has : boolean
>"x" in v : boolean
>"x" : "x"
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const same2 = identity(v);               // generic: decided by the instantiation, stays raw
>same2 : { x: number; y: number; } & import("./threads.mjs").Cell
>identity(v) : { x: number; y: number; } & import("./threads.mjs").Cell
>identity : <T>(x: T) => T
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    return [text, kind, same, isNull, union, object, list, record, copy, s, x, has, same2.y];
