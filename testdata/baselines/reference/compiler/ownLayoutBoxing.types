>struct : { <F extends Record<string, import("./threads.mjs").Field<any>>>(fields: F): import("./threads.mjs").StructType<{ -readonly [K in keyof F]: F[K] extends import("./threads.mjs").Field<infer V> ? V : never; }>; <T>(fields: { [K in keyof T]-?: import("./threads.mjs").Field<T[K]>; }): import("./threads.mjs").StructType<T>; }
>Struct : any

export const Vec = struct({ x: f64, y: f64 });
>Vec : import("./threads.mjs").StructType<{ x: number; y: number; }>
>struct({ x: f64, y: f64 }) : import("./threads.mjs").StructType<{ x: number; y: number; }>
>struct : { <F extends Record<string, import("./threads.mjs").Field<any>>>(fields: F): import("./threads.mjs").StructType<{ -readonly [K in keyof F]: F[K] extends import("./threads.mjs").Field<infer V> ? V : never; }>; <T>(fields: { [K in keyof T]-?: import("./threads.mjs").Field<T[K]>; }): import("./threads.mjs").StructType<T>; }
>{ x: f64, y: f64 } : { x: import("./threads.mjs").Field<number>; y: import("./threads.mjs").Field<number>; }
>x : import("./threads.mjs").Field<number>
>f64 : import("./threads.mjs").Field<number>
>y : import("./threads.mjs").Field<number>
>f64 : import("./threads.mjs").Field<number>

export type Vec = Struct<typeof Vec>;
>Vec : { x: number; y: number; } & import("./threads.mjs").Cell
>Vec : import("./threads.mjs").StructType<{ x: number; y: number; }>

declare function takeVec(v: Vec): void;
>takeVec : (v: Vec) => void
>v : { x: number; y: number; } & import("./threads.mjs").Cell

declare function takeUnknown(u: unknown): void;
>takeUnknown : (u: unknown) => void
>u : unknown

declare function identity<T>(x: T): T;
>identity : <T>(x: T) => T
>x : T

declare const anything: any;
>anything : any

export function roundTrip(v: Vec) {
>roundTrip : (v: Vec) => number
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const u: unknown = v;                    // box
>u : unknown
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const v2 = u as Vec;                     // unbox
>v2 : { x: number; y: number; } & import("./threads.mjs").Cell
>u as Vec : { x: number; y: number; } & import("./threads.mjs").Cell
>u : unknown

    return v2.x;
>v2.x : number
>v2 : { x: number; y: number; } & import("./threads.mjs").Cell
>x : number
}

export function boxed(v: Vec, other: unknown, a: SharedArray<number>) {
>boxed : (v: Vec, other: unknown, a: SharedArray<number>) => (string | number | boolean | object)[]
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>other : unknown
>a : SharedArray<number>

    log(v, a);                               // host function arguments
>log(v, a) : void
>log : (...args: unknown[]) => void
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>a : SharedArray<number>

    takeUnknown(v);
>takeUnknown(v) : void
>takeUnknown : (u: unknown) => void
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const text = `${v} and ` + v;            // strings
>text : string
>`${v} and ` + v : string
>`${v} and ` : string
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const kind = typeof v;
>kind : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>typeof v : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const same = v === other;                // equality with a non-struct value
>same : boolean
>v === other : boolean
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>other : unknown

    const isNull = v === null;               // stays raw
>isNull : boolean
>v === null : boolean
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const union: Vec | number = v;
>union : number | ({ x: number; y: number; } & import("./threads.mjs").Cell)
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const object: object = v;
>object : object
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const list: unknown[] = [v, a];
>list : unknown[]
>[v, a] : (SharedArray<number> | ({ x: number; y: number; } & import("./threads.mjs").Cell))[]
>v : { x: number; y: number; } & import("./threads.mjs").Cell
>a : SharedArray<number>

    const record: { v: unknown } = { v };
>record : { v: unknown; }
>v : unknown
>{ v } : { v: { x: number; y: number; } & import("./threads.mjs").Cell; }
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const copy = { ...v };
>copy : { [cellBrand]: true; x: number; y: number; }
>{ ...v } : { [cellBrand]: true; x: number; y: number; }
>v : { x: number; y: number; } & import("./threads.mjs").Cell

    const s = v.toString();                  // not a field
