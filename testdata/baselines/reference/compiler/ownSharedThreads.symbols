//// [tests/cases/compiler/ownSharedThreads.ts] ////

=== own.d.ts ===
// Library surface for the "own and shared threads" examples.
//
// `sending T` marks a value whose ownership moves to the receiver: the sender must not use it
// afterwards (`consume x` hands over a local). `shared T` marks a deeply immutable value that any
// number of threads may read at the same time.

/** One slot per thread. A thread publishes into its own slot; everyone can read every slot. */
declare class Slots<T> {
>Slots : Symbol(Slots, Decl(own.d.ts, 0, 0))
>T : Symbol(T, Decl(own.d.ts, 7, 20))

  constructor(count: number);
>count : Symbol(count, Decl(own.d.ts, 8, 14))

  /** Publishes `value` in slot `index`, replacing what was there. */
  set(index: number, value: T): void;
>set : Symbol(Slots.set, Decl(own.d.ts, 8, 29))
>index : Symbol(index, Decl(own.d.ts, 10, 6))
>value : Symbol(value, Decl(own.d.ts, 10, 20))
>T : Symbol(T, Decl(own.d.ts, 7, 20))

  /** Gets the value in slot `index`. */
  get(index: number): T;
>get : Symbol(Slots.get, Decl(own.d.ts, 10, 37))
>index : Symbol(index, Decl(own.d.ts, 12, 6))
>T : Symbol(T, Decl(own.d.ts, 7, 20))

  /** Concatenates the arrays in all slots, in slot order. */
  flat(): T extends readonly (infer E)[] ? shared E[] : never;
>flat : Symbol(Slots.flat, Decl(own.d.ts, 12, 24))
>T : Symbol(T, Decl(own.d.ts, 7, 20))
>E : Symbol(E, Decl(own.d.ts, 14, 35))
>E : Symbol(E, Decl(own.d.ts, 14, 35))
}

/** A reusable barrier for a fixed number of threads. */
declare class Barrier {
>Barrier : Symbol(Barrier, Decl(own.d.ts, 15, 1))

  constructor(threads: number);
>threads : Symbol(threads, Decl(own.d.ts, 19, 14))

  /** Blocks until all threads have called `wait`. */
  wait(): void;
>wait : Symbol(Barrier.wait, Decl(own.d.ts, 19, 31))
}

/** Freezes a value the caller owns into a deeply immutable, shareable value. */
declare function share<T>(value: sending T): shared T;
>share : Symbol(share, Decl(own.d.ts, 22, 1))
>T : Symbol(T, Decl(own.d.ts, 25, 23))
>value : Symbol(value, Decl(own.d.ts, 25, 26))
>T : Symbol(T, Decl(own.d.ts, 25, 23))
>T : Symbol(T, Decl(own.d.ts, 25, 23))

/** A thread started inside a `scope`; joining it hands back the thread's result. */
interface Thread<R> {
>Thread : Symbol(Thread, Decl(own.d.ts, 25, 54))
>R : Symbol(R, Decl(own.d.ts, 28, 17))

  join(): sending R;
>join : Symbol(Thread.join, Decl(own.d.ts, 28, 21))
>R : Symbol(R, Decl(own.d.ts, 28, 17))
}

/** Spawns threads that cannot outlive the scope. */
interface Scope {
>Scope : Symbol(Scope, Decl(own.d.ts, 30, 1))

  spawn<A extends unknown[], R>(fn: (...args: A) => sending R, ...args: A): Thread<R>;
>spawn : Symbol(Scope.spawn, Decl(own.d.ts, 33, 17))
>A : Symbol(A, Decl(own.d.ts, 34, 8))
>R : Symbol(R, Decl(own.d.ts, 34, 28))
>fn : Symbol(fn, Decl(own.d.ts, 34, 32))
>args : Symbol(args, Decl(own.d.ts, 34, 37))
>A : Symbol(A, Decl(own.d.ts, 34, 8))
>R : Symbol(R, Decl(own.d.ts, 34, 28))
>args : Symbol(args, Decl(own.d.ts, 34, 62))
>A : Symbol(A, Decl(own.d.ts, 34, 8))
>Thread : Symbol(Thread, Decl(own.d.ts, 25, 54))
>R : Symbol(R, Decl(own.d.ts, 34, 28))
}

/** Runs `body` and joins every thread it spawned before returning. */
