>ref<Task>() : import("./threads.mjs").Field<Task | null>
>ref : <T>() => import("./threads.mjs").Field<T | null>
>urgent : import("./threads.mjs").Field<boolean>
>bool : import("./threads.mjs").Field<boolean>

export function finish(t: Task): boolean {
>finish : (t: Task) => boolean
>t : Task

    const was = t.done;
>was : boolean
>t.done : boolean
>t : Task
>done : boolean

    t.done = true;
>t.done = true : true
>t.done : boolean
>t : Task
>done : boolean
>true : true

    t.urgent = !t.urgent;
>t.urgent = !t.urgent : boolean
>t.urgent : boolean
>t : Task
>urgent : boolean
>!t.urgent : boolean
>t.urgent : boolean
>t : Task
>urgent : boolean

    if (t.next && !t.next.done) t.next.urgent = was || t.urgent;
>t.next && !t.next.done : boolean | null
>t.next : Task | null
>t : Task
>next : Task | null
>!t.next.done : boolean
>t.next.done : boolean
>t.next : Task
>t : Task
>next : Task
>done : boolean
>t.next.urgent = was || t.urgent : boolean
>t.next.urgent : boolean
>t.next : Task
>t : Task
>next : Task
>urgent : boolean
>was || t.urgent : boolean
>was : boolean
>t.urgent : boolean
>t : Task
>urgent : boolean

    return t.done && !was;
>t.done && !was : boolean
>t.done : true
>t : Task
>done : true
>!was : boolean
>was : boolean
}

// A logical assignment's value is a boolean too.
export function mark(t: Task, flag: boolean): boolean {
>mark : (t: Task, flag: boolean) => boolean
>t : Task
>flag : boolean

    const a = (t.done ||= flag);
>a : boolean
>(t.done ||= flag) : boolean
>t.done ||= flag : boolean
>t.done : boolean
>t : Task
>done : boolean
>flag : boolean

    const b = (t.urgent &&= flag);
>b : boolean
>(t.urgent &&= flag) : boolean
>t.urgent &&= flag : boolean
>t.urgent : boolean
>t : Task
>urgent : boolean
>flag : boolean

    t.done ??= flag;                                  // a boolean is never null: only read
>t.done ??= flag : boolean
>t.done : boolean
>t : Task
>done : boolean
>flag : boolean

    return a && b;
>a && b : boolean
>a : boolean
>b : boolean
}

// Destructuring into a boolean field stores the byte.
export function assign(t: Task, pair: [boolean, number]) {
>assign : (t: Task, pair: [boolean, number]) => void
>t : Task
>pair : [boolean, number]

    [t.done, t.id] = pair;
>[t.done, t.id] = pair : [boolean, number]
>[t.done, t.id] : [boolean, number]
>t.done : boolean
>t : Task
>done : boolean
>t.id : number
>t : Task
>id : number
>pair : [boolean, number]

    for (t.urgent of [true, false]) {}
>t.urgent : boolean
>t : Task
>urgent : boolean
>[true, false] : boolean[]
>true : true
>false : false
}

export function sieve(n: number): number {
>sieve : (n: number) => number
>n : number

    const composite = new SharedArray(Boolean, n);
>composite : SharedArray<boolean>
>new SharedArray(Boolean, n) : SharedArray<boolean>
>SharedArray : { new (type: NumberConstructor, length: number): SharedArray<number>; new (type: BooleanConstructor, length: number): SharedArray<boolean>; new <T>(type: import("./threads.mjs").StructType<T>, length: number): SharedArray<T & import("./threads.mjs").Cell>; }
>Boolean : BooleanConstructor
>n : number

    let primes = 0;
>primes : number
>0 : 0

    for (let i = 2; i < composite.length; i++) {
>i : number
>2 : 2
>i < composite.length : boolean
>i : number
>composite.length : number
>composite : SharedArray<boolean>
>length : number
>i++ : number
>i : number

        if (composite[i]) continue;               // in bounds: no check
>composite[i] : boolean
>composite : SharedArray<boolean>
>i : number

        primes++;
>primes++ : number
>primes : number

        for (let j = i * i; j < n; j += i) composite[j] = true;
>j : number
>i * i : number
>i : number
>i : number
>j < n : boolean
>j : number
>n : number
>j += i : number
>j : number
>i : number
>composite[j] = true : true
>composite[j] : boolean
>composite : SharedArray<boolean>
>j : number
>true : true
    }
    composite[n - 1] ||= composite[0];
>composite[n - 1] ||= composite[0] : boolean
>composite[n - 1] : boolean
>composite : SharedArray<boolean>
>n - 1 : number
>n : number
>1 : 1
>composite[0] : boolean
>composite : SharedArray<boolean>
>0 : 0

    return primes + composite.length;
>primes + composite.length : number
>primes : number
>composite.length : number
>composite : SharedArray<boolean>
>length : number
}

