>struct<Task>({ id: f64, done: bool, next: ref<Task>(), urgent: bool }) : import("./threads.mjs").StructType<Task>
>struct : { <F extends Record<string, import("./threads.mjs").Field<any>>>(fields: F): import("./threads.mjs").StructType<{ -readonly [K in keyof F]: F[K] extends import("./threads.mjs").Field<infer V> ? V : never; }>; <T>(fields: { [K in keyof T]-?: import("./threads.mjs").Field<T[K]>; }): import("./threads.mjs").StructType<T>; }
>{ id: f64, done: bool, next: ref<Task>(), urgent: bool } : { id: import("./threads.mjs").Field<number>; done: import("./threads.mjs").Field<boolean>; next: import("./threads.mjs").Field<Task | null>; urgent: import("./threads.mjs").Field<boolean>; }
>id : import("./threads.mjs").Field<number>
