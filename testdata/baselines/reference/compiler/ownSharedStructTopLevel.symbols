=== ownSharedStructTopLevel.ts ===
// A shared struct's value is initialized by its declaration, like a class: a module can use it at
// the top level (and still not before its declaration).

export const early = new Late();             // error: used before its declaration
>early : Symbol(early, Decl(ownSharedStructTopLevel.ts, 3, 12))
>Late : Symbol(Late, Decl(ownSharedStructTopLevel.ts, 3, 32))

shared struct Late { v: number }
>Late : Symbol(Late, Decl(ownSharedStructTopLevel.ts, 3, 32))
>v : Symbol(Late.v, Decl(ownSharedStructTopLevel.ts, 4, 20))

shared struct Point { x: number; y: number }
>Point : Symbol(Point, Decl(ownSharedStructTopLevel.ts, 4, 32))
>x : Symbol(Point.x, Decl(ownSharedStructTopLevel.ts, 6, 21))
>y : Symbol(Point.y, Decl(ownSharedStructTopLevel.ts, 6, 32))

const origin = new Point();
>origin : Symbol(origin, Decl(ownSharedStructTopLevel.ts, 7, 5))
>Point : Symbol(Point, Decl(ownSharedStructTopLevel.ts, 4, 32))

export const x = origin.x;
>x : Symbol(x, Decl(ownSharedStructTopLevel.ts, 8, 12))
>origin.x : Symbol(Point.x, Decl(ownSharedStructTopLevel.ts, 6, 21))
>origin : Symbol(origin, Decl(ownSharedStructTopLevel.ts, 7, 5))
>x : Symbol(Point.x, Decl(ownSharedStructTopLevel.ts, 6, 21))

