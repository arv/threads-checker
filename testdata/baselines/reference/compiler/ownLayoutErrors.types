>new SharedArray<string>(Good as any, 3) : SharedArray<string>
>SharedArray : { new (type: NumberConstructor, length: number): SharedArray<number>; new <T>(type: import("./own.mjs").SharedStructType<T>, length: number): SharedArray<T>; }
>Good as any : any
