// Sends: the message takes a count of its own, and the sender's count is released as usual.
export function sends(ch: Channel<Node>, box: Box, mine: Sending<Node>) {
>sends : (ch: Channel<Node>, box: Box, mine: Sending<Node>) => void
>ch : Channel<Node>
>box : { item: Node | null; } & import("./threads.mjs").Cell
>mine : Node

    const n = new Node();
>n : Node & import("./threads.mjs").Cell
>new Node() : Node & import("./threads.mjs").Cell
>Node : import("./threads.mjs").StructType<Node>

    ch.send(n);                              // an owned local
>ch.send(n) : void
>ch.send : (value: Node) => void
>ch : Channel<Node>
>send : (value: Node) => void
>n : Node & import("./threads.mjs").Cell

    ch.send(new Node());                     // an owned temporary, released after the statement
>ch.send(new Node()) : void
>ch.send : (value: Node) => void
>ch : Channel<Node>
>send : (value: Node) => void
>new Node() : Node & import("./threads.mjs").Cell
>Node : import("./threads.mjs").StructType<Node>

    ch.send(box.item!);                      // a reference field: retained by `__ref` at once
>ch.send(box.item!) : void
>ch.send : (value: Node) => void
>ch : Channel<Node>
>send : (value: Node) => void
>box.item! : Node
>box.item : Node | null
>box : { item: Node | null; } & import("./threads.mjs").Cell
>item : Node | null

    ch.send(mine);                           // a parameter declared `Sending<Node>`
>ch.send(mine) : void
>ch.send : (value: Node) => void
>ch : Channel<Node>
>send : (value: Node) => void
>mine : Node
}

// A thread's arguments share a counted value: the same array goes to every thread.
export function threads(ch: Channel<Node>, arr: SharedArray<number>) {
>threads : (ch: Channel<Node>, arr: SharedArray<number>) => number
>ch : Channel<Node>
>arr : SharedArray<number>

    go(worker, arr, ch);
>go(worker, arr, ch) : void
>go : <A extends unknown[]>(f: (...args: A) => void, ...args: Sending<A>) => void
>worker : (arr: SharedArray<number>, ch: Channel<Node>) => void
>arr : SharedArray<number>
>ch : Channel<Node>

    go(worker, arr, ch);
>go(worker, arr, ch) : void
>go : <A extends unknown[]>(f: (...args: A) => void, ...args: Sending<A>) => void
>worker : (arr: SharedArray<number>, ch: Channel<Node>) => void
>arr : SharedArray<number>
>ch : Channel<Node>

    return arr.length;
>arr.length : number
>arr : SharedArray<number>
>length : number
}

