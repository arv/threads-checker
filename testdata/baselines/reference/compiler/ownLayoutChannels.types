// A thread's arguments share a counted value: the same array goes to every thread.
export function threads(ch: shared ChannelCell<Node>, arr: SharedArray<number>) {
>threads : (ch: shared ChannelCell<Node>, arr: SharedArray<number>) => number
>ch : ChannelCell<Node>
>arr : SharedArray<number>

    go(worker, arr, ch);
>go(worker, arr, ch) : void
>go : <A extends unknown[]>(f: (...args: A) => void, ...args: sending A) => void
>worker : (arr: SharedArray<number>, ch: shared ChannelCell<Node>) => void
>arr : SharedArray<number>
