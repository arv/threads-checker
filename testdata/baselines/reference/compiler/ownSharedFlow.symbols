>flag : Symbol(flag, Decl(flow.mts, 7, 13))

            if (flag) break outer;
>flag : Symbol(flag, Decl(flow.mts, 7, 13))

            continue outer;
        }
    }
    send(b);                                  // fine
>send : Symbol(send, Decl(flow.mts, 2, 37))
>b : Symbol(b, Decl(flow.mts, 45, 9))

    for (const x of [make()]) send(x);        // error on the next iteration: elements share the array's region
>x : Symbol(x, Decl(flow.mts, 53, 14))
>make : Symbol(make, Decl(flow.mts, 4, 52))
>send : Symbol(send, Decl(flow.mts, 2, 37))
