>i : Symbol(i, Decl(flow.mts, 37, 12))
>i : Symbol(i, Decl(flow.mts, 37, 12))

        use(a);                               // error: sent in the previous iteration
>use : Symbol(use, Decl(flow.mts, 5, 38))
>a : Symbol(a, Decl(flow.mts, 36, 9))

        send(a);
>send : Symbol(send, Decl(flow.mts, 2, 37))
>a : Symbol(a, Decl(flow.mts, 36, 9))
    }
    for (let i = 0; i < 3; i++) {
>i : Symbol(i, Decl(flow.mts, 41, 12))
>i : Symbol(i, Decl(flow.mts, 41, 12))
>i : Symbol(i, Decl(flow.mts, 41, 12))

        const fresh = make();
>fresh : Symbol(fresh, Decl(flow.mts, 42, 13))
