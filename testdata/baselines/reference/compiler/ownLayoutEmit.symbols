}

export function elements(vs: SharedArray<Vec>, i: number) {
>elements : Symbol(elements, Decl(layout.mts, 18, 1))
>vs : Symbol(vs, Decl(layout.mts, 20, 25))
>SharedArray : Symbol(SharedArray, Decl(layout.mts, 0, 8))
>Vec : Symbol(Vec, Decl(layout.mts, 0, 40))
>i : Symbol(i, Decl(layout.mts, 20, 46))

    const v = vs[i];                        // element address, bounds-checked
>v : Symbol(v, Decl(layout.mts, 21, 9))
>vs : Symbol(vs, Decl(layout.mts, 20, 25))
>i : Symbol(i, Decl(layout.mts, 20, 46))

    vs[i].x = vs[i + 1].y;                  // chains; index not simple: temporary
>vs[i].x : Symbol(Vec.x, Decl(layout.mts, 2, 26))
>vs : Symbol(vs, Decl(layout.mts, 20, 25))
>i : Symbol(i, Decl(layout.mts, 20, 46))
>x : Symbol(Vec.x, Decl(layout.mts, 2, 26))
>vs[i + 1].y : Symbol(Vec.y, Decl(layout.mts, 2, 37))
>vs : Symbol(vs, Decl(layout.mts, 20, 25))
>i : Symbol(i, Decl(layout.mts, 20, 46))
>y : Symbol(Vec.y, Decl(layout.mts, 2, 37))

    const n = vs.length;                    // header word
>n : Symbol(n, Decl(layout.mts, 23, 9))
>vs.length : Symbol(SharedArray.length, Decl(own.d.mts, 62, 33))
>vs : Symbol(vs, Decl(layout.mts, 20, 25))
>length : Symbol(SharedArray.length, Decl(own.d.mts, 62, 33))

    const w = arrays()[pick()];             // array and index not simple: temporaries
>w : Symbol(w, Decl(layout.mts, 24, 9))
>arrays : Symbol(arrays, Decl(layout.mts, 6, 32))
>pick : Symbol(pick, Decl(layout.mts, 5, 29))

    return n + w.z + v.x;
>n : Symbol(n, Decl(layout.mts, 23, 9))
