>trail : Symbol(Particle.trail, Decl(layout.mts, 3, 55))
>i : Symbol(i, Decl(layout.mts, 28, 60))
>a.length : Symbol(SharedArray.length, Decl(own.d.mts, 62, 33))
>a : Symbol(a, Decl(layout.mts, 28, 24))
>length : Symbol(SharedArray.length, Decl(own.d.mts, 62, 33))

    return a[i];
>a : Symbol(a, Decl(layout.mts, 28, 24))
>i : Symbol(i, Decl(layout.mts, 28, 60))
}

