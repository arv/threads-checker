>Field : Symbol(Field, Decl(threads.d.mts, 10, 1))
>T : Symbol(T, Decl(threads.d.mts, 13, 23))

  readonly [fieldBrand]: T;
>[fieldBrand] : Symbol(Field[fieldBrand], Decl(threads.d.mts, 13, 27))
>fieldBrand : Symbol(fieldBrand, Decl(threads.d.mts, 5, 13))
>T : Symbol(T, Decl(threads.d.mts, 13, 23))
}
