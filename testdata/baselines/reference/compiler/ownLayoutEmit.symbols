>A : Symbol(A, Decl(own.d.mts, 37, 10))
>R : Symbol(R, Decl(own.d.mts, 37, 30))
>f : Symbol(f, Decl(own.d.mts, 37, 34))
>args : Symbol(args, Decl(own.d.mts, 37, 38))
>A : Symbol(A, Decl(own.d.mts, 37, 10))
>R : Symbol(R, Decl(own.d.mts, 37, 30))
>args : Symbol(args, Decl(own.d.mts, 37, 63))
>A : Symbol(A, Decl(own.d.mts, 37, 10))
>Thread : Symbol(Thread, Decl(own.d.mts, 28, 61))
>R : Symbol(R, Decl(own.d.mts, 37, 30))
}

/** Runs `body` and joins every thread it spawned before returning. */
