>p : Symbol(p, Decl(layout.mts, 9, 30))
>Particle : Symbol(Particle, Decl(layout.mts, 2, 60))

    const x = v.x;                          // read: slot 1
>x : Symbol(x, Decl(layout.mts, 10, 9))
>v.x : Symbol(Vec.x, Decl(layout.mts, 2, 26))
>v : Symbol(v, Decl(layout.mts, 9, 23))
>x : Symbol(Vec.x, Decl(layout.mts, 2, 26))

    v.z = x + v.y;                          // write
>v.z : Symbol(Vec.z, Decl(layout.mts, 2, 48))
>v : Symbol(v, Decl(layout.mts, 9, 23))
>z : Symbol(Vec.z, Decl(layout.mts, 2, 48))
>x : Symbol(x, Decl(layout.mts, 10, 9))
>v.y : Symbol(Vec.y, Decl(layout.mts, 2, 37))
>v : Symbol(v, Decl(layout.mts, 9, 23))
>y : Symbol(Vec.y, Decl(layout.mts, 2, 37))

    v.x += 1;                               // compound assignment
>v.x : Symbol(Vec.x, Decl(layout.mts, 2, 26))
>v : Symbol(v, Decl(layout.mts, 9, 23))
>x : Symbol(Vec.x, Decl(layout.mts, 2, 26))

    v.y++;                                  // postfix
>v.y : Symbol(Vec.y, Decl(layout.mts, 2, 37))
>v : Symbol(v, Decl(layout.mts, 9, 23))
>y : Symbol(Vec.y, Decl(layout.mts, 2, 37))

    --v.z;                                  // prefix
>v.z : Symbol(Vec.z, Decl(layout.mts, 2, 48))
>v : Symbol(v, Decl(layout.mts, 9, 23))
>z : Symbol(Vec.z, Decl(layout.mts, 2, 48))

    const m = make().y;                     // object with side effects: no temporary needed
>m : Symbol(m, Decl(layout.mts, 15, 9))
>make().y : Symbol(Vec.y, Decl(layout.mts, 2, 37))
>make : Symbol(make, Decl(layout.mts, 3, 84))
>y : Symbol(Vec.y, Decl(layout.mts, 2, 37))

    p.pos.x = p.mass;                       // chain through a struct-typed field
>p.pos.x : Symbol(Vec.x, Decl(layout.mts, 2, 26))
>p.pos : Symbol(Particle.pos, Decl(layout.mts, 3, 31))
>p : Symbol(p, Decl(layout.mts, 9, 30))
>pos : Symbol(Particle.pos, Decl(layout.mts, 3, 31))
>x : Symbol(Vec.x, Decl(layout.mts, 2, 26))
