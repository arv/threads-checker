export function fields(v: Vec, p: Particle) {
>fields : Symbol(fields, Decl(layout.mts, 9, 44))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>Vec : Symbol(Vec, Decl(layout.mts, 2, 12), Decl(layout.mts, 2, 54))
>p : Symbol(p, Decl(layout.mts, 11, 30))
>Particle : Symbol(Particle, Decl(layout.mts, 4, 12), Decl(layout.mts, 4, 98))

    const x = v.x;                          // read: slot 1
>x : Symbol(x, Decl(layout.mts, 12, 9))
>v.x : Symbol(x, Decl(layout.mts, 2, 27))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>x : Symbol(x, Decl(layout.mts, 2, 27))

    v.z = x + v.y;                          // write
>v.z : Symbol(z, Decl(layout.mts, 2, 43))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>z : Symbol(z, Decl(layout.mts, 2, 43))
>x : Symbol(x, Decl(layout.mts, 12, 9))
>v.y : Symbol(y, Decl(layout.mts, 2, 35))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>y : Symbol(y, Decl(layout.mts, 2, 35))

    v.x += 1;                               // compound assignment
>v.x : Symbol(x, Decl(layout.mts, 2, 27))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>x : Symbol(x, Decl(layout.mts, 2, 27))

    v.y++;                                  // postfix
>v.y : Symbol(y, Decl(layout.mts, 2, 35))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>y : Symbol(y, Decl(layout.mts, 2, 35))

    --v.z;                                  // prefix
>v.z : Symbol(z, Decl(layout.mts, 2, 43))
>v : Symbol(v, Decl(layout.mts, 11, 23))
>z : Symbol(z, Decl(layout.mts, 2, 43))

    const m = make().y;                     // object with side effects: no temporary needed
>m : Symbol(m, Decl(layout.mts, 17, 9))
>make().y : Symbol(y, Decl(layout.mts, 2, 35))
>make : Symbol(make, Decl(layout.mts, 5, 47))
>y : Symbol(y, Decl(layout.mts, 2, 35))

    p.pos!.x = p.mass;                      // chain through a struct-typed field
>p.pos!.x : Symbol(x, Decl(layout.mts, 2, 27))
>p.pos : Symbol(pos, Decl(layout.mts, 4, 32))
>p : Symbol(p, Decl(layout.mts, 11, 30))
>pos : Symbol(pos, Decl(layout.mts, 4, 32))
>x : Symbol(x, Decl(layout.mts, 2, 27))
>p.mass : Symbol(mass, Decl(layout.mts, 4, 49))
>p : Symbol(p, Decl(layout.mts, 11, 30))
>mass : Symbol(mass, Decl(layout.mts, 4, 49))

    return v === p.pos;                     // addresses compare as numbers
>v : Symbol(v, Decl(layout.mts, 11, 23))
>p.pos : Symbol(pos, Decl(layout.mts, 4, 32))
>p : Symbol(p, Decl(layout.mts, 11, 30))
>pos : Symbol(pos, Decl(layout.mts, 4, 32))
}

export function elements(vs: SharedArray<Vec>, i: number) {
>elements : Symbol(elements, Decl(layout.mts, 20, 1))
>vs : Symbol(vs, Decl(layout.mts, 22, 25))
>SharedArray : Symbol(SharedArray, Decl(layout.mts, 0, 18))
>Vec : Symbol(Vec, Decl(layout.mts, 2, 12), Decl(layout.mts, 2, 54))
>i : Symbol(i, Decl(layout.mts, 22, 46))

    const v = vs[i];                        // element address, bounds-checked
>v : Symbol(v, Decl(layout.mts, 23, 9))
>vs : Symbol(vs, Decl(layout.mts, 22, 25))
>i : Symbol(i, Decl(layout.mts, 22, 46))

    vs[i].x = vs[i + 1].y;                  // chains; index not simple: temporary
>vs[i].x : Symbol(x, Decl(layout.mts, 2, 27))
>vs : Symbol(vs, Decl(layout.mts, 22, 25))
>i : Symbol(i, Decl(layout.mts, 22, 46))
>x : Symbol(x, Decl(layout.mts, 2, 27))
>vs[i + 1].y : Symbol(y, Decl(layout.mts, 2, 35))
>vs : Symbol(vs, Decl(layout.mts, 22, 25))
>i : Symbol(i, Decl(layout.mts, 22, 46))
>y : Symbol(y, Decl(layout.mts, 2, 35))

    const n = vs.length;                    // header word
>n : Symbol(n, Decl(layout.mts, 25, 9))
>vs.length : Symbol(SharedArray.length, Decl(threads.d.mts, 39, 46))
>vs : Symbol(vs, Decl(layout.mts, 22, 25))
>length : Symbol(SharedArray.length, Decl(threads.d.mts, 39, 46))

    const w = arrays()[pick()];             // array and index not simple: temporaries
>w : Symbol(w, Decl(layout.mts, 26, 9))
>arrays : Symbol(arrays, Decl(layout.mts, 8, 32))
>pick : Symbol(pick, Decl(layout.mts, 7, 29))

    return n + w.z + v.x;
>n : Symbol(n, Decl(layout.mts, 25, 9))
>w.z : Symbol(z, Decl(layout.mts, 2, 43))
>w : Symbol(w, Decl(layout.mts, 26, 9))
>z : Symbol(z, Decl(layout.mts, 2, 43))
>v.x : Symbol(x, Decl(layout.mts, 2, 27))
>v : Symbol(v, Decl(layout.mts, 23, 9))
>x : Symbol(x, Decl(layout.mts, 2, 27))
}

export function numbers(a: SharedArray<number>, p: Particle, i: number) {
>numbers : Symbol(numbers, Decl(layout.mts, 28, 1))
>a : Symbol(a, Decl(layout.mts, 30, 24))
>SharedArray : Symbol(SharedArray, Decl(layout.mts, 0, 18))
>p : Symbol(p, Decl(layout.mts, 30, 47))
>Particle : Symbol(Particle, Decl(layout.mts, 4, 12), Decl(layout.mts, 4, 98))
>i : Symbol(i, Decl(layout.mts, 30, 60))

    const first = a[0];                     // read
>first : Symbol(first, Decl(layout.mts, 31, 9))
>a : Symbol(a, Decl(layout.mts, 30, 24))

    a[i] = first * 2;                       // write
>a : Symbol(a, Decl(layout.mts, 30, 24))
>i : Symbol(i, Decl(layout.mts, 30, 60))
>first : Symbol(first, Decl(layout.mts, 31, 9))

    a[i + 1] += 3;                          // compound assignment, index not simple
>a : Symbol(a, Decl(layout.mts, 30, 24))
>i : Symbol(i, Decl(layout.mts, 30, 60))

    a[i]++;
>a : Symbol(a, Decl(layout.mts, 30, 24))
>i : Symbol(i, Decl(layout.mts, 30, 60))

    p.trail![i] = a.length;                 // array from a field: temporary
>p.trail : Symbol(trail, Decl(layout.mts, 4, 60))
>p : Symbol(p, Decl(layout.mts, 30, 47))
>trail : Symbol(trail, Decl(layout.mts, 4, 60))
>i : Symbol(i, Decl(layout.mts, 30, 60))
>a.length : Symbol(SharedArray.length, Decl(threads.d.mts, 39, 46))
>a : Symbol(a, Decl(layout.mts, 30, 24))
>length : Symbol(SharedArray.length, Decl(threads.d.mts, 39, 46))

    return a[i];
>a : Symbol(a, Decl(layout.mts, 30, 24))
>i : Symbol(i, Decl(layout.mts, 30, 60))
}

