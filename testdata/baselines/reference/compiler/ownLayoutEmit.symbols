export function numbers(a: SharedArray<number>, p: Particle, i: number) {
>numbers : Symbol(numbers, Decl(layout.mts, 26, 1))
>a : Symbol(a, Decl(layout.mts, 28, 24))
>SharedArray : Symbol(SharedArray, Decl(layout.mts, 0, 8))
>p : Symbol(p, Decl(layout.mts, 28, 47))
>Particle : Symbol(Particle, Decl(layout.mts, 2, 60))
>i : Symbol(i, Decl(layout.mts, 28, 60))

    const first = a[0];                     // read
>first : Symbol(first, Decl(layout.mts, 29, 9))
>a : Symbol(a, Decl(layout.mts, 28, 24))

    a[i] = first * 2;                       // write
>a : Symbol(a, Decl(layout.mts, 28, 24))
>i : Symbol(i, Decl(layout.mts, 28, 60))
>first : Symbol(first, Decl(layout.mts, 29, 9))

    a[i + 1] += 3;                          // compound assignment, index not simple
>a : Symbol(a, Decl(layout.mts, 28, 24))
>i : Symbol(i, Decl(layout.mts, 28, 60))

    a[i]++;
>a : Symbol(a, Decl(layout.mts, 28, 24))
>i : Symbol(i, Decl(layout.mts, 28, 60))

    p.trail[i] = a.length;                  // array from a field: temporary
