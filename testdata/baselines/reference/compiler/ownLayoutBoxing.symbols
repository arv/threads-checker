>length : Symbol(SharedArray.length, Decl(own.d.mts, 62, 33))

    [index: number]: T;
>index : Symbol(index, Decl(own.d.mts, 64, 5))
>T : Symbol(T, Decl(own.d.mts, 62, 29))
}
export declare const SharedArray: {
>SharedArray : Symbol(SharedArray, Decl(own.d.mts, 55, 1), Decl(own.d.mts, 66, 20))

    new (type: NumberConstructor, length: number): SharedArray<number>;
>type : Symbol(type, Decl(own.d.mts, 67, 9))
>NumberConstructor : Symbol(NumberConstructor, Decl(lib.es5.d.ts, --, --), Decl(lib.es2015.core.d.ts, --, --))
>length : Symbol(length, Decl(own.d.mts, 67, 33))
>SharedArray : Symbol(SharedArray, Decl(own.d.mts, 55, 1), Decl(own.d.mts, 66, 20))

    new <T>(type: SharedStructType<T>, length: number): SharedArray<T>;
>T : Symbol(T, Decl(own.d.mts, 68, 9))
>type : Symbol(type, Decl(own.d.mts, 68, 12))
