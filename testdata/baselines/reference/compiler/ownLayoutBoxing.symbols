export function roundTrip(v: Vec) {
>roundTrip : Symbol(roundTrip, Decl(boxing.mts, 8, 28))
>v : Symbol(v, Decl(boxing.mts, 10, 26))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))

    const u: unknown = v;                    // box
>u : Symbol(u, Decl(boxing.mts, 11, 9))
>v : Symbol(v, Decl(boxing.mts, 10, 26))

