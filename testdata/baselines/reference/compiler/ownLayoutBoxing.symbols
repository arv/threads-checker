>SharedArray : Symbol(SharedArray, Decl(threads.d.mts, 33, 92), Decl(threads.d.mts, 43, 20))

  new <T>(type: StructType<T>, length: number): SharedArray<T & Cell>;
>T : Symbol(T, Decl(threads.d.mts, 45, 7))
>type : Symbol(type, Decl(threads.d.mts, 45, 10))
>StructType : Symbol(StructType, Decl(threads.d.mts, 19, 50))
