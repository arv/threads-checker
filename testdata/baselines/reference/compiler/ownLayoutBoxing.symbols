>u : Symbol(u, Decl(boxing.mts, 46, 15))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))

    return u !== null && typeof u === "object" && "x" in u;
>u : Symbol(u, Decl(boxing.mts, 46, 15))
>u : Symbol(u, Decl(boxing.mts, 46, 15))
>u : Symbol(u, Decl(boxing.mts, 46, 15))
}

