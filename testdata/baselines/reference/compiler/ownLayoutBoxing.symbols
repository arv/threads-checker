>v2 : Symbol(v2, Decl(boxing.mts, 12, 9))
>u : Symbol(u, Decl(boxing.mts, 11, 9))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))

    return v2.x;
>v2.x : Symbol(x, Decl(boxing.mts, 2, 27))
>v2 : Symbol(v2, Decl(boxing.mts, 12, 9))
>x : Symbol(x, Decl(boxing.mts, 2, 27))
}

export function boxed(v: Vec, other: unknown, a: SharedArray<number>) {
>boxed : Symbol(boxed, Decl(boxing.mts, 14, 1))
>v : Symbol(v, Decl(boxing.mts, 16, 22))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))
>other : Symbol(other, Decl(boxing.mts, 16, 29))
>a : Symbol(a, Decl(boxing.mts, 16, 45))
>SharedArray : Symbol(SharedArray, Decl(boxing.mts, 0, 18))

    log(v, a);                               // host function arguments
>log : Symbol(log, Decl(boxing.mts, 0, 13))
>v : Symbol(v, Decl(boxing.mts, 16, 22))
>a : Symbol(a, Decl(boxing.mts, 16, 45))

    takeUnknown(v);
>takeUnknown : Symbol(takeUnknown, Decl(boxing.mts, 5, 39))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const text = `${v} and ` + v;            // strings
>text : Symbol(text, Decl(boxing.mts, 19, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const kind = typeof v;
>kind : Symbol(kind, Decl(boxing.mts, 20, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const same = v === other;                // equality with a non-struct value
>same : Symbol(same, Decl(boxing.mts, 21, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))
>other : Symbol(other, Decl(boxing.mts, 16, 29))

    const isNull = v === null;               // stays raw
>isNull : Symbol(isNull, Decl(boxing.mts, 22, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const union: Vec | number = v;
>union : Symbol(union, Decl(boxing.mts, 23, 9))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const object: object = v;
>object : Symbol(object, Decl(boxing.mts, 24, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const list: unknown[] = [v, a];
>list : Symbol(list, Decl(boxing.mts, 25, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))
>a : Symbol(a, Decl(boxing.mts, 16, 45))

    const record: { v: unknown } = { v };
>record : Symbol(record, Decl(boxing.mts, 26, 9))
>v : Symbol(v, Decl(boxing.mts, 26, 19))
>v : Symbol(v, Decl(boxing.mts, 26, 36))

    const copy = { ...v };
>copy : Symbol(copy, Decl(boxing.mts, 27, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const s = v.toString();                  // not a field
>s : Symbol(s, Decl(boxing.mts, 28, 9))
>v.toString : Symbol(Object.toString, Decl(lib.es5.d.ts, --, --))
>v : Symbol(v, Decl(boxing.mts, 16, 22))
>toString : Symbol(Object.toString, Decl(lib.es5.d.ts, --, --))

    const { x } = v;                         // destructured through the handle
>x : Symbol(x, Decl(boxing.mts, 29, 11))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const has = "x" in v;
>has : Symbol(has, Decl(boxing.mts, 30, 9))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    const same2 = identity(v);               // generic: decided by the instantiation, stays raw
>same2 : Symbol(same2, Decl(boxing.mts, 31, 9))
>identity : Symbol(identity, Decl(boxing.mts, 6, 47))
>v : Symbol(v, Decl(boxing.mts, 16, 22))

    return [text, kind, same, isNull, union, object, list, record, copy, s, x, has, same2.y];
>text : Symbol(text, Decl(boxing.mts, 19, 9))
>kind : Symbol(kind, Decl(boxing.mts, 20, 9))
>same : Symbol(same, Decl(boxing.mts, 21, 9))
>isNull : Symbol(isNull, Decl(boxing.mts, 22, 9))
>union : Symbol(union, Decl(boxing.mts, 23, 9))
>object : Symbol(object, Decl(boxing.mts, 24, 9))
>list : Symbol(list, Decl(boxing.mts, 25, 9))
>record : Symbol(record, Decl(boxing.mts, 26, 9))
>copy : Symbol(copy, Decl(boxing.mts, 27, 9))
>s : Symbol(s, Decl(boxing.mts, 28, 9))
>x : Symbol(x, Decl(boxing.mts, 29, 11))
>has : Symbol(has, Decl(boxing.mts, 30, 9))
>same2.y : Symbol(y, Decl(boxing.mts, 2, 35))
>same2 : Symbol(same2, Decl(boxing.mts, 31, 9))
>y : Symbol(y, Decl(boxing.mts, 2, 35))
}

export function unboxed(u: unknown, a: any) {
>unboxed : Symbol(unboxed, Decl(boxing.mts, 33, 1))
>u : Symbol(u, Decl(boxing.mts, 35, 24))
>a : Symbol(a, Decl(boxing.mts, 35, 35))

    takeVec(anything);                       // any into a struct parameter
>takeVec : Symbol(takeVec, Decl(boxing.mts, 3, 37))
>anything : Symbol(anything, Decl(boxing.mts, 8, 13))

    const v = u as Vec;
>v : Symbol(v, Decl(boxing.mts, 37, 9))
>u : Symbol(u, Decl(boxing.mts, 35, 24))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))

    const w: Vec = a;
>w : Symbol(w, Decl(boxing.mts, 38, 9))
>Vec : Symbol(Vec, Decl(boxing.mts, 2, 12), Decl(boxing.mts, 2, 46))
>a : Symbol(a, Decl(boxing.mts, 35, 35))

    if (isVec(u)) {
>isVec : Symbol(isVec, Decl(boxing.mts, 44, 1))
>u : Symbol(u, Decl(boxing.mts, 35, 24))

        u.x = 1;                             // narrowed: unboxed where the layout is used
>u.x : Symbol(x, Decl(boxing.mts, 2, 27))
>u : Symbol(u, Decl(boxing.mts, 35, 24))
>x : Symbol(x, Decl(boxing.mts, 2, 27))

        takeVec(u);
>takeVec : Symbol(takeVec, Decl(boxing.mts, 3, 37))
>u : Symbol(u, Decl(boxing.mts, 35, 24))
    }
    return v.y + w.y;
>v.y : Symbol(y, Decl(boxing.mts, 2, 35))
>v : Symbol(v, Decl(boxing.mts, 37, 9))
>y : Symbol(y, Decl(boxing.mts, 2, 35))
>w.y : Symbol(y, Decl(boxing.mts, 2, 35))
>w : Symbol(w, Decl(boxing.mts, 38, 9))
>y : Symbol(y, Decl(boxing.mts, 2, 35))
}

