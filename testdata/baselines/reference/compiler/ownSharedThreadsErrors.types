=== errors.ts ===
// Programs that the ownership analysis rejects, one per kind of error, and one that it accepts.
// Compile with `tsgo -p tsconfig.errors.json`; nbody.ts provides `worker`, `Body` and `Pos`.

// 1. Use after send, through another variable that shares objects with the sent one.
function sendHalf(bodies: sending Body[], s: shared Scope, board: shared SlotsCell<Pos[]>, barrier: shared BarrierCell) {
>sendHalf : (bodies: sending Body[], s: shared Scope, board: shared SlotsCell<Pos[]>, barrier: shared BarrierCell) => void
>bodies : Body[]
>s : Scope
>board : SlotsCell<Pos[]>
>barrier : BarrierCell

  const half = bodies.slice(0, 400);
>half : Body[]
>bodies.slice(0, 400) : Body[]
>bodies.slice : (start?: number, end?: number) => Body[]
>bodies : Body[]
>slice : (start?: number, end?: number) => Body[]
>0 : 0
>400 : 400

  s.spawn(worker, 0, half, board, barrier);   // half shares bodies' region: sends it
>s.spawn(worker, 0, half, board, barrier) : Thread<Body[]>
>s.spawn : <A extends unknown[], R>(f: (...args: A) => sending R, ...args: sending A) => shared Thread<R>
>s : Scope
>spawn : <A extends unknown[], R>(f: (...args: A) => sending R, ...args: sending A) => shared Thread<R>
>worker : (t: number, mine: sending Body[], board: shared SlotsCell<Pos[]>, barrier: shared BarrierCell) => sending Body[]
>0 : 0
>half : Body[]
>board : SlotsCell<Pos[]>
>barrier : BarrierCell

  bodies[0].x = 1;                            // error: 'bodies' shares objects with 'half', which was sent
>bodies[0].x = 1 : 1
>bodies[0].x : number
>bodies[0] : Body
>bodies : Body[]
>0 : 0
>x : number
>1 : 1
