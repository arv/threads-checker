>mine : Symbol(mine, Decl(channels.mts, 8, 50))
>Sending : Symbol(Sending, Decl(channels.mts, 0, 44))
>Node : Symbol(Node, Decl(channels.mts, 0, 102), Decl(channels.mts, 3, 12))

    const n = new Node();
>n : Symbol(n, Decl(channels.mts, 9, 9))
>Node : Symbol(Node, Decl(channels.mts, 0, 102), Decl(channels.mts, 3, 12))

    ch.send(n);                              // an owned local
>ch.send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>ch : Symbol(ch, Decl(channels.mts, 8, 22))
>send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>n : Symbol(n, Decl(channels.mts, 9, 9))

    ch.send(new Node());                     // an owned temporary, released after the statement
>ch.send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>ch : Symbol(ch, Decl(channels.mts, 8, 22))
>send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>Node : Symbol(Node, Decl(channels.mts, 0, 102), Decl(channels.mts, 3, 12))

    ch.send(box.item!);                      // a reference field: retained by `__ref` at once
>ch.send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>ch : Symbol(ch, Decl(channels.mts, 8, 22))
>send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>box.item : Symbol(item, Decl(channels.mts, 4, 27))
>box : Symbol(box, Decl(channels.mts, 8, 40))
>item : Symbol(item, Decl(channels.mts, 4, 27))

    ch.send(mine);                           // a parameter declared `Sending<Node>`
>ch.send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>ch : Symbol(ch, Decl(channels.mts, 8, 22))
>send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
