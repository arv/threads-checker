>arr : Symbol(arr, Decl(channels.mts, 17, 42))
>SharedArray : Symbol(SharedArray, Decl(channels.mts, 0, 31))

    go(worker, arr, ch);
>go : Symbol(go, Decl(channels.mts, 0, 22))
>worker : Symbol(worker, Decl(channels.mts, 21, 1))
>arr : Symbol(arr, Decl(channels.mts, 17, 42))
>ch : Symbol(ch, Decl(channels.mts, 17, 24))

    go(worker, arr, ch);
>go : Symbol(go, Decl(channels.mts, 0, 22))
>worker : Symbol(worker, Decl(channels.mts, 21, 1))
>arr : Symbol(arr, Decl(channels.mts, 17, 42))
>ch : Symbol(ch, Decl(channels.mts, 17, 24))

    return arr.length;
>arr.length : Symbol(SharedArray.length, Decl(threads.d.mts, 44, 46))
>arr : Symbol(arr, Decl(channels.mts, 17, 42))
>length : Symbol(SharedArray.length, Decl(threads.d.mts, 44, 46))
}

