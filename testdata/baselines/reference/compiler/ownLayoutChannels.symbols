>Channel : Symbol(Channel, Decl(channels.mts, 0, 8))
>Node : Symbol(Node, Decl(channels.mts, 0, 102), Decl(channels.mts, 3, 12))

    for (const n of ch) arr[0] += n.value;
>n : Symbol(n, Decl(channels.mts, 25, 14))
>ch : Symbol(ch, Decl(channels.mts, 24, 41))
>arr : Symbol(arr, Decl(channels.mts, 24, 16))
