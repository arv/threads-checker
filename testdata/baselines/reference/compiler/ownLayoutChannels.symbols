// Sends: the message takes a count of its own, and the sender's count is released as usual.
export function sends(ch: Channel<Node>, box: Box, mine: Sending<Node>) {
>sends : Symbol(sends, Decl(channels.mts, 5, 37))
>ch : Symbol(ch, Decl(channels.mts, 8, 22))
>Channel : Symbol(Channel, Decl(channels.mts, 0, 8))
>Node : Symbol(Node, Decl(channels.mts, 0, 102), Decl(channels.mts, 3, 12))
>box : Symbol(box, Decl(channels.mts, 8, 40))
