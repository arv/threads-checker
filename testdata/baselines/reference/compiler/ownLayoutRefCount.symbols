export function stores(box: Box, p: Node) {
>stores : Symbol(stores, Decl(list.mts, 90, 73))
>box : Symbol(box, Decl(list.mts, 91, 23))
>Box : Symbol(Box, Decl(list.mts, 2, 62))
>p : Symbol(p, Decl(list.mts, 91, 32))
>Node : Symbol(Node, Decl(list.mts, 0, 39))

    use(box.item);                           // an unstable borrow passed to a function: retained around the call
>use : Symbol(use, Decl(list.mts, 87, 1))
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))

    use(p);                                  // a stable borrow: as it is
>use : Symbol(use, Decl(list.mts, 87, 1))
>p : Symbol(p, Decl(list.mts, 91, 32))

    box.item = p;                            // a borrow: retained
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))
>p : Symbol(p, Decl(list.mts, 91, 32))

    box.item = created(1);                   // owned: stored as it is
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))
>created : Symbol(created, Decl(list.mts, 29, 1))

    box.item = null;
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))

    box.item ??= p;
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))
>p : Symbol(p, Decl(list.mts, 91, 32))

    p.next = box.item;
>p.next : Symbol(Node.next, Decl(list.mts, 2, 42))
>p : Symbol(p, Decl(list.mts, 91, 32))
>next : Symbol(Node.next, Decl(list.mts, 2, 42))
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))

    box.item!.value = use(p);                // an unstable object and a call in the value: retained first
>box.item!.value : Symbol(Node.value, Decl(list.mts, 2, 27))
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))
>value : Symbol(Node.value, Decl(list.mts, 2, 27))
>use : Symbol(use, Decl(list.mts, 87, 1))
>p : Symbol(p, Decl(list.mts, 91, 32))

    log(box.item);                           // boxed: the handle holds its own count
>log : Symbol(log, Decl(list.mts, 0, 8))
>box.item : Symbol(Box.item, Decl(list.mts, 3, 26))
>box : Symbol(box, Decl(list.mts, 91, 23))
>item : Symbol(Box.item, Decl(list.mts, 3, 26))
}

// Rules 7 and 8: spawn takes a counted argument, and a closure holds what it captures.
export function threads(box: Box) {
>threads : Symbol(threads, Decl(list.mts, 101, 1))
>box : Symbol(box, Decl(list.mts, 104, 24))
>Box : Symbol(Box, Decl(list.mts, 2, 62))

    const list = makeList(3);
>list : Symbol(list, Decl(list.mts, 105, 9))
>makeList : Symbol(makeList, Decl(list.mts, 3, 46))

    scope(s => {
>scope : Symbol(scope, Decl(list.mts, 0, 13))
>s : Symbol(s, Decl(list.mts, 106, 10))

        s.spawn(sum, list);
>s.spawn : Symbol(Scope.spawn, Decl(own.d.mts, 36, 24))
>s : Symbol(s, Decl(list.mts, 106, 10))
>spawn : Symbol(Scope.spawn, Decl(own.d.mts, 36, 24))
>sum : Symbol(sum, Decl(list.mts, 16, 1))
>list : Symbol(list, Decl(list.mts, 105, 9))

        s.spawn(stores, box, created(4));
>s.spawn : Symbol(Scope.spawn, Decl(own.d.mts, 36, 24))
>s : Symbol(s, Decl(list.mts, 106, 10))
>spawn : Symbol(Scope.spawn, Decl(own.d.mts, 36, 24))
>stores : Symbol(stores, Decl(list.mts, 90, 73))
>box : Symbol(box, Decl(list.mts, 104, 24))
>created : Symbol(created, Decl(list.mts, 29, 1))

    });
    function total() { return sum(list); }
>total : Symbol(total, Decl(list.mts, 109, 7))
>sum : Symbol(sum, Decl(list.mts, 16, 1))
>list : Symbol(list, Decl(list.mts, 105, 9))

    return total;
>total : Symbol(total, Decl(list.mts, 109, 7))
}

