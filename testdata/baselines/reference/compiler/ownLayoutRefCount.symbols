>i : Symbol(i, Decl(list.mts, 49, 12))
>i : Symbol(i, Decl(list.mts, 49, 12))
>rounds : Symbol(rounds, Decl(list.mts, 43, 33))
>i : Symbol(i, Decl(list.mts, 49, 12))
>total : Symbol(total, Decl(list.mts, 48, 7))
>i : Symbol(i, Decl(list.mts, 49, 12))

