// The linked list: building it (`head` is reassigned, so it is owned, and `node` is new), and
// returning it (the owned local's count moves out).
export function makeList(n: number): Node | null {
>makeList : Symbol(makeList, Decl(list.mts, 5, 37))
>n : Symbol(n, Decl(list.mts, 9, 25))
>Node : Symbol(Node, Decl(list.mts, 0, 74), Decl(list.mts, 3, 12))

    let head: Node | null = null;
>head : Symbol(head, Decl(list.mts, 10, 7))
>Node : Symbol(Node, Decl(list.mts, 0, 74), Decl(list.mts, 3, 12))

    for (let i = 0; i < n; i++) {
>i : Symbol(i, Decl(list.mts, 11, 12))
>i : Symbol(i, Decl(list.mts, 11, 12))
>n : Symbol(n, Decl(list.mts, 9, 25))
>i : Symbol(i, Decl(list.mts, 11, 12))

        const node = new Node();
>node : Symbol(node, Decl(list.mts, 12, 13))
>Node : Symbol(Node, Decl(list.mts, 0, 74), Decl(list.mts, 3, 12))

        node.value = i;
>node.value : Symbol(Node.value, Decl(list.mts, 2, 23))
>node : Symbol(node, Decl(list.mts, 12, 13))
>value : Symbol(Node.value, Decl(list.mts, 2, 23))
>i : Symbol(i, Decl(list.mts, 11, 12))

        node.next = head;                    // a borrow stored in a reference field: retained
>node.next : Symbol(Node.next, Decl(list.mts, 2, 38))
>node : Symbol(node, Decl(list.mts, 12, 13))
>next : Symbol(Node.next, Decl(list.mts, 2, 38))
>head : Symbol(head, Decl(list.mts, 10, 7))

        head = node;                         // the new value is retained before the old is released
>head : Symbol(head, Decl(list.mts, 10, 7))
>node : Symbol(node, Decl(list.mts, 12, 13))
    }
    return head;
>head : Symbol(head, Decl(list.mts, 10, 7))
}

// Traversal: `n` is reassigned, so it is owned (its declaration moves out of the loop); the loop
// reads a reference field, so each iteration ends at a quiescent point.
export function sum(head: Node | null): number {
>sum : Symbol(sum, Decl(list.mts, 18, 1))
>head : Symbol(head, Decl(list.mts, 22, 20))
>Node : Symbol(Node, Decl(list.mts, 0, 74), Decl(list.mts, 3, 12))

    let s = 0;
>s : Symbol(s, Decl(list.mts, 23, 7))

    for (let n = head; n !== null; n = n.next) s += n.value;
>n : Symbol(n, Decl(list.mts, 24, 12))
>head : Symbol(head, Decl(list.mts, 22, 20))
>n : Symbol(n, Decl(list.mts, 24, 12))
>n : Symbol(n, Decl(list.mts, 24, 12))
>n.next : Symbol(Node.next, Decl(list.mts, 2, 38))
>n : Symbol(n, Decl(list.mts, 24, 12))
>next : Symbol(Node.next, Decl(list.mts, 2, 38))
>s : Symbol(s, Decl(list.mts, 23, 7))
>n.value : Symbol(Node.value, Decl(list.mts, 2, 23))
>n : Symbol(n, Decl(list.mts, 24, 12))
>value : Symbol(Node.value, Decl(list.mts, 2, 23))

    return s;
>s : Symbol(s, Decl(list.mts, 23, 7))
}

