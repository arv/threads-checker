>go : Symbol(go, Decl(moves.mts, 0, 27))
>work : Symbol(work, Decl(moves.mts, 59, 1))
>n : Symbol(n, Decl(moves.mts, 64, 9))

    ch.send(holder.next!);
>ch.send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
>ch : Symbol(ch, Decl(moves.mts, 63, 25))
>send : Symbol(Channel.send, Decl(threads.d.mts, 57, 33))
