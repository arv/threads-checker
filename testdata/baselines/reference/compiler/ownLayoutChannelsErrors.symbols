>holder : Symbol(holder, Decl(moves.mts, 63, 43))
>Node : Symbol(Node, Decl(moves.mts, 0, 102), Decl(moves.mts, 3, 12))

    const n = new Node();
>n : Symbol(n, Decl(moves.mts, 64, 9))
>Node : Symbol(Node, Decl(moves.mts, 0, 102), Decl(moves.mts, 3, 12))

    go(work, n);
>go : Symbol(go, Decl(moves.mts, 0, 27))
>work : Symbol(work, Decl(moves.mts, 59, 1))
>n : Symbol(n, Decl(moves.mts, 64, 9))

