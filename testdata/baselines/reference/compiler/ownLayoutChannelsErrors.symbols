// select returns its value in an ordinary tuple, where nothing could count it.
export function selects(a: Channel<Node>, b: Channel<Node>) {
>selects : Symbol(selects, Decl(moves.mts, 69, 1))
>a : Symbol(a, Decl(moves.mts, 72, 24))
>Channel : Symbol(Channel, Decl(moves.mts, 0, 8))
>Node : Symbol(Node, Decl(moves.mts, 0, 102), Decl(moves.mts, 3, 12))
>b : Symbol(b, Decl(moves.mts, 72, 41))
>Channel : Symbol(Channel, Decl(moves.mts, 0, 8))
>Node : Symbol(Node, Decl(moves.mts, 0, 102), Decl(moves.mts, 3, 12))

    const result = select(a, b);             // error
>result : Symbol(result, Decl(moves.mts, 73, 9))
>select : Symbol(select, Decl(moves.mts, 0, 36))
>a : Symbol(a, Decl(moves.mts, 72, 24))
>b : Symbol(b, Decl(moves.mts, 72, 41))

    return result[0];
>result : Symbol(result, Decl(moves.mts, 73, 9))
>0 : Symbol(0)
}

// A for-of over a channel owns its values; over an ordinary array, it cannot.
export function loops(ch: Channel<Node>, list: Node[]) {
>loops : Symbol(loops, Decl(moves.mts, 75, 1))
>ch : Symbol(ch, Decl(moves.mts, 78, 22))
>Channel : Symbol(Channel, Decl(moves.mts, 0, 8))
>Node : Symbol(Node, Decl(moves.mts, 0, 102), Decl(moves.mts, 3, 12))
>list : Symbol(list, Decl(moves.mts, 78, 40))
>Node : Symbol(Node, Decl(moves.mts, 0, 102), Decl(moves.mts, 3, 12))

    let total = 0;
>total : Symbol(total, Decl(moves.mts, 79, 7))

    for (const n of ch) total += n.value;
>n : Symbol(n, Decl(moves.mts, 80, 14))
>ch : Symbol(ch, Decl(moves.mts, 78, 22))
>total : Symbol(total, Decl(moves.mts, 79, 7))
>n.value : Symbol(Node.value, Decl(moves.mts, 2, 23))
>n : Symbol(n, Decl(moves.mts, 80, 14))
>value : Symbol(Node.value, Decl(moves.mts, 2, 23))

    for (const n of list) total += n.value;  // error
>n : Symbol(n, Decl(moves.mts, 81, 14))
>list : Symbol(list, Decl(moves.mts, 78, 40))
>total : Symbol(total, Decl(moves.mts, 79, 7))
>n.value : Symbol(Node.value, Decl(moves.mts, 2, 23))
>n : Symbol(n, Decl(moves.mts, 81, 14))
>value : Symbol(Node.value, Decl(moves.mts, 2, 23))

    return total;
>total : Symbol(total, Decl(moves.mts, 79, 7))
}

