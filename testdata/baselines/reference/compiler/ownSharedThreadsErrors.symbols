>A : Symbol(A, Decl(own.d.ts, 35, 10))
>R : Symbol(R, Decl(own.d.ts, 35, 30))
>args : Symbol(args, Decl(own.d.ts, 35, 63))
>A : Symbol(A, Decl(own.d.ts, 35, 10))
>Thread : Symbol(Thread, Decl(own.d.ts, 26, 54))
>R : Symbol(R, Decl(own.d.ts, 35, 30))
}

/** Runs `body` and joins every thread it spawned before returning. */
declare function scope<R>(body: (s: shared Scope) => R): R;
