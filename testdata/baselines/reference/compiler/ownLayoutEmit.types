>{ pos: ref<Vec>(), mass: f64, trail: ref<SharedArray<number>>() } : { pos: import("./threads.mjs").Field<({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null>; mass: import("./threads.mjs").Field<number>; trail: import("./threads.mjs").Field<SharedArray<number> | null>; }
