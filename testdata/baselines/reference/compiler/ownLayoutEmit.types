declare function make(): Vec;
>make : () => Vec

declare function pick(): number;
>pick : () => number

declare function arrays(): SharedArray<Vec>;
>arrays : () => SharedArray<Vec>

export function fields(v: Vec, p: Particle) {
>fields : (v: Vec, p: Particle) => boolean
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>p : { pos: ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null; mass: number; trail: SharedArray<number> | null; } & import("./threads.mjs").Cell

    const x = v.x;                          // read: slot 1
>x : number
>v.x : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>x : number

    v.z = x + v.y;                          // write
>v.z = x + v.y : number
>v.z : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>z : number
>x + v.y : number
>x : number
>v.y : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>y : number

    v.x += 1;                               // compound assignment
>v.x += 1 : number
>v.x : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>x : number
>1 : 1

    v.y++;                                  // postfix
>v.y++ : number
>v.y : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>y : number

    --v.z;                                  // prefix
>--v.z : number
>v.z : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>z : number

    const m = make().y;                     // object with side effects: no temporary needed
>m : number
>make().y : number
>make() : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>make : () => Vec
>y : number

    p.pos!.x = p.mass;                      // chain through a struct-typed field
>p.pos!.x = p.mass : number
>p.pos!.x : number
>p.pos! : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>p.pos : ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null
>p : { pos: ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null; mass: number; trail: SharedArray<number> | null; } & import("./threads.mjs").Cell
>pos : ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null
>x : number
>p.mass : number
>p : { pos: ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null; mass: number; trail: SharedArray<number> | null; } & import("./threads.mjs").Cell
>mass : number

    return v === p.pos;                     // addresses compare as numbers
>v === p.pos : boolean
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>p.pos : ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null
>p : { pos: ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null; mass: number; trail: SharedArray<number> | null; } & import("./threads.mjs").Cell
>pos : ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null
}

export function elements(vs: SharedArray<Vec>, i: number) {
>elements : (vs: SharedArray<Vec>, i: number) => number
>vs : SharedArray<{ x: number; y: number; z: number; } & import("./threads.mjs").Cell>
>i : number

    const v = vs[i];                        // element address, bounds-checked
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>vs[i] : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>vs : SharedArray<{ x: number; y: number; z: number; } & import("./threads.mjs").Cell>
>i : number

    vs[i].x = vs[i + 1].y;                  // chains; index not simple: temporary
>vs[i].x = vs[i + 1].y : number
>vs[i].x : number
>vs[i] : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>vs : SharedArray<{ x: number; y: number; z: number; } & import("./threads.mjs").Cell>
>i : number
>x : number
>vs[i + 1].y : number
>vs[i + 1] : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>vs : SharedArray<{ x: number; y: number; z: number; } & import("./threads.mjs").Cell>
>i + 1 : number
>i : number
>1 : 1
>y : number

    const n = vs.length;                    // header word
>n : number
>vs.length : number
>vs : SharedArray<{ x: number; y: number; z: number; } & import("./threads.mjs").Cell>
>length : number

    const w = arrays()[pick()];             // array and index not simple: temporaries
>w : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>arrays()[pick()] : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>arrays() : SharedArray<{ x: number; y: number; z: number; } & import("./threads.mjs").Cell>
>arrays : () => SharedArray<Vec>
>pick() : number
>pick : () => number

    return n + w.z + v.x;
>n + w.z + v.x : number
>n + w.z : number
>n : number
>w.z : number
>w : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>z : number
>v.x : number
>v : { x: number; y: number; z: number; } & import("./threads.mjs").Cell
>x : number
}

export function numbers(a: SharedArray<number>, p: Particle, i: number) {
>numbers : (a: SharedArray<number>, p: Particle, i: number) => number
>a : SharedArray<number>
>p : { pos: ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null; mass: number; trail: SharedArray<number> | null; } & import("./threads.mjs").Cell
>i : number

    const first = a[0];                     // read
>first : number
>a[0] : number
>a : SharedArray<number>
>0 : 0

    a[i] = first * 2;                       // write
>a[i] = first * 2 : number
>a[i] : number
>a : SharedArray<number>
>i : number
>first * 2 : number
>first : number
>2 : 2

    a[i + 1] += 3;                          // compound assignment, index not simple
>a[i + 1] += 3 : number
>a[i + 1] : number
>a : SharedArray<number>
>i + 1 : number
>i : number
>1 : 1
>3 : 3

    a[i]++;
>a[i]++ : number
>a[i] : number
>a : SharedArray<number>
>i : number

    p.trail![i] = a.length;                 // array from a field: temporary
>p.trail![i] = a.length : number
>p.trail![i] : number
>p.trail! : SharedArray<number>
>p.trail : SharedArray<number> | null
>p : { pos: ({ x: number; y: number; z: number; } & import("./threads.mjs").Cell) | null; mass: number; trail: SharedArray<number> | null; } & import("./threads.mjs").Cell
>trail : SharedArray<number> | null
>i : number
>a.length : number
>a : SharedArray<number>
>length : number

    return a[i];
>a[i] : number
>a : SharedArray<number>
>i : number
}

