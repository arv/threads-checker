}

export function sum(t: Tree): number {
>sum : Symbol(sum, Decl(tree.mts, 9, 1))
>t : Symbol(t, Decl(tree.mts, 11, 20))
>Tree : Symbol(Tree, Decl(tree.mts, 0, 62), Decl(tree.mts, 3, 12))

    let total = t.value;
>total : Symbol(total, Decl(tree.mts, 12, 7))
>t.value : Symbol(Tree.value, Decl(tree.mts, 2, 23))
>t : Symbol(t, Decl(tree.mts, 11, 20))
>value : Symbol(Tree.value, Decl(tree.mts, 2, 23))

    const children = t.children;
>children : Symbol(children, Decl(tree.mts, 13, 9))
>t.children : Symbol(Tree.children, Decl(tree.mts, 2, 38))
>t : Symbol(t, Decl(tree.mts, 11, 20))
>children : Symbol(Tree.children, Decl(tree.mts, 2, 38))

    if (children) {
>children : Symbol(children, Decl(tree.mts, 13, 9))

        for (let i = 0; i < children.length; i++) {
>i : Symbol(i, Decl(tree.mts, 15, 16))
>i : Symbol(i, Decl(tree.mts, 15, 16))
>children.length : Symbol(SharedArray.length, Decl(threads.d.mts, 39, 46))
>children : Symbol(children, Decl(tree.mts, 13, 9))
>length : Symbol(SharedArray.length, Decl(threads.d.mts, 39, 46))
>i : Symbol(i, Decl(tree.mts, 15, 16))

            total += sum(children[i]);
>total : Symbol(total, Decl(tree.mts, 12, 7))
>sum : Symbol(sum, Decl(tree.mts, 9, 1))
>children : Symbol(children, Decl(tree.mts, 13, 9))
>i : Symbol(i, Decl(tree.mts, 15, 16))
        }
    }
