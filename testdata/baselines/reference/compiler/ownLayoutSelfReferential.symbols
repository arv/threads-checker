>Tree : Symbol(Tree, Decl(tree.mts, 0, 62), Decl(tree.mts, 3, 12))
>n : Symbol(n, Decl(tree.mts, 5, 29))

    t.children[0].value = t.value + 1;      // element of the struct's own array
>t.children[0].value : Symbol(Tree.value, Decl(tree.mts, 2, 23))
>t.children : Symbol(Tree.children, Decl(tree.mts, 2, 38))
>t : Symbol(t, Decl(tree.mts, 5, 21))
