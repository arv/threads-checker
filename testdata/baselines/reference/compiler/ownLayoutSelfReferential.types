>value : number
>children : SharedArray<Tree> | null

export const Tree = struct<Tree>({ value: f64, children: ref<SharedArray<Tree>>() });
>Tree : import("./threads.mjs").StructType<Tree>
>struct<Tree>({ value: f64, children: ref<SharedArray<Tree>>() }) : import("./threads.mjs").StructType<Tree>
>struct : { <F extends Record<string, import("./threads.mjs").Field<any>>>(fields: F): import("./threads.mjs").StructType<{ -readonly [K in keyof F]: F[K] extends import("./threads.mjs").Field<infer V> ? V : never; }>; <T>(fields: { [K in keyof T]-?: import("./threads.mjs").Field<T[K]>; }): import("./threads.mjs").StructType<T>; }
>{ value: f64, children: ref<SharedArray<Tree>>() } : { value: import("./threads.mjs").Field<number>; children: import("./threads.mjs").Field<SharedArray<Tree> | null>; }
>value : import("./threads.mjs").Field<number>
