import { type Sending, type Shared, share } from "./threads.mjs";
>Sending : any
>Shared : any
>share : <T>(value: Sending<T>) => Shared<T>

type Pos = { x: number };
>Pos : Pos
>x : number

type Positions = { t: number; pos: Pos[] };
