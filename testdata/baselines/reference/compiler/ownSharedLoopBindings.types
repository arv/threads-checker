export function linked(steps: number) {
>linked : (steps: number) => void
>steps : number

    const outer: Pos[] = [];
>outer : Pos[]
>[] : never[]

    for (let s = 0; s < steps; s++) {
>s : number
>0 : 0
>s < steps : boolean
>s : number
>steps : number
