>t : number
>pos : Pos[]

declare function send<T>(x: Sending<T>): void;
>send : <T>(x: Sending<T>) => void
>x : T

declare function recv(): Sending<Positions | undefined>;
>recv : () => Sending<Positions | undefined>

declare function use(xs: Shared<Pos[]>): void;
>use : (xs: Shared<Pos[]>) => void
>xs : readonly { readonly x: number; }[]

// The n-body gather: each step builds `slots` from received messages, then shares it.
export function gather(steps: number, threads: number) {
>gather : (steps: number, threads: number) => void
>steps : number
>threads : number

    for (let s = 0; s < steps; s++) {
>s : number
>0 : 0
>s < steps : boolean
>s : number
>steps : number
>s++ : number
>s : number

        const slots: Pos[][] = [];
>slots : Pos[][]
>[] : never[]

        for (let k = 0; k < threads; k++) {
>k : number
>0 : 0
>k < threads : boolean
>k : number
>threads : number
>k++ : number
>k : number

            const m = recv()!;
>m : Positions
>recv()! : Positions
>recv() : Positions | undefined
>recv : () => Sending<Positions | undefined>

            slots[m.t] = m.pos;
>slots[m.t] = m.pos : Pos[]
>slots[m.t] : Pos[]
>slots : Pos[][]
>m.t : number
>m : Positions
>t : number
>m.pos : Pos[]
>m : Positions
>pos : Pos[]
        }
        const all = share(slots.flat());
>all : readonly { readonly x: number; }[]
>share(slots.flat()) : readonly { readonly x: number; }[]
>share : <T>(value: Sending<T>) => Shared<T>
>slots.flat() : Pos[]
>slots.flat : <A, D extends number = 1>(this: A, depth?: D | undefined) => FlatArray<A, D>[]
>slots : Pos[][]
>flat : <A, D extends number = 1>(this: A, depth?: D | undefined) => FlatArray<A, D>[]

        use(all);
>use(all) : void
>use : (xs: Shared<Pos[]>) => void
>all : readonly { readonly x: number; }[]
    }
}

export function nested(steps: number) {
>nested : (steps: number) => void
>steps : number

    for (let s = 0; s < steps; s++) {
>s : number
>0 : 0
>s < steps : boolean
>s : number
>steps : number
>s++ : number
>s : number

        do {
            const { pos } = recv()!;          // destructured: fresh bindings too
>pos : Pos[]
>recv()! : Positions
>recv() : Positions | undefined
>recv : () => Sending<Positions | undefined>

            send(pos);
>send(pos) : void
>send : <T>(x: Sending<T>) => void
>pos : Pos[]

        } while (steps > s);
>steps > s : boolean
>steps : number
>s : number

        let last: Pos[] = [];
>last : Pos[]
>[] : never[]

        while (last.length < 3) {
>last.length < 3 : boolean
>last.length : number
>last : Pos[]
>length : number
>3 : 3

            const next = recv()!.pos;
>next : Pos[]
>recv()!.pos : Pos[]
>recv()! : Positions
>recv() : Positions | undefined
>recv : () => Sending<Positions | undefined>
>pos : Pos[]

            last.push(...next);
>last.push(...next) : number
>last.push : (...items: Pos[]) => number
>last : Pos[]
>push : (...items: Pos[]) => number
>...next : Pos
>next : Pos[]
        }
        send(last);
>send(last) : void
>send : <T>(x: Sending<T>) => void
>last : Pos[]
    }
}

export function outside(steps: number) {
>outside : (steps: number) => void
>steps : number

    const slots: Pos[][] = [];
>slots : Pos[][]
>[] : never[]

    for (let s = 0; s < steps; s++) {
>s : number
>0 : 0
>s < steps : boolean
>s : number
>steps : number
>s++ : number
>s : number

        const all = share(slots.flat());      // error: sent in an earlier iteration
>all : readonly { readonly x: number; }[]
>share(slots.flat()) : readonly { readonly x: number; }[]
>share : <T>(value: Sending<T>) => Shared<T>
>slots.flat() : Pos[]
>slots.flat : <A, D extends number = 1>(this: A, depth?: D | undefined) => FlatArray<A, D>[]
>slots : Pos[][]
>flat : <A, D extends number = 1>(this: A, depth?: D | undefined) => FlatArray<A, D>[]

        use(all);
>use(all) : void
>use : (xs: Shared<Pos[]>) => void
>all : readonly { readonly x: number; }[]
